mod TestSigil do

  -- RC helper: derive a fresh independent copy of the path for each consuming
  -- call site using "" ++ p so that each stdlib I/O function gets its own
  -- owned string regardless of whether the function takes :own or :borrow.
  fn watcher_roundtrip(base : String) : Bool do
    let _ = Dir.mkdir_p(base)
    let _ = Watcher.write_version(base, 42)
    let v  = Watcher.read_version(base)
    let _ = Dir.rm_rf(base)
    v == 42
  end

  describe "Config" do
    test "default uses standard dirs" do
      let s = Config.default()
      assert (Config.site_content_dir(s) == "content")
      assert (Config.site_output_dir(s) == "out")
    end
  end

  describe "Build.run" do
    test "run succeeds on two md files" do
      let tmp = "/tmp/sigil_m0_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "hello.md"), "<p>Hello</p>")
      let _ = File.write(Path.join(content_dir, "world.md"), "<p>World</p>")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let result = Build.run(site)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let _ = Dir.rm_rf(tmp)
    end

    test "hello.html exists and contains body" do
      let tmp = "/tmp/sigil_hello_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "hello.md"), "Hello")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "hello.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "Hello"))
      let _ = Dir.rm_rf(tmp)
    end

    test "output is a full html document" do
      let tmp = "/tmp/sigil_doc_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "page.md"), "hello")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "page.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "<!DOCTYPE html>"))
      let _ = Dir.rm_rf(tmp)
    end

    test "skips non-md files" do
      let tmp = "/tmp/sigil_skip_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "page.md"), "hello")
      let _ = File.write(Path.join(content_dir, "style.css"), "body {}")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      -- The two-pass build also generates sitemap.xml, feed.xml, and tag/ dir.
      -- Assert that style.css was NOT copied to output (only .md files get processed).
      let css_out = Path.join(output_dir, "style.css")
      let css_exists = match File.read(css_out) do Ok(_) -> true | Err(_) -> false end
      assert (not(css_exists))
      let html_out = Path.join(output_dir, "page.html")
      let html_exists = match File.read(html_out) do Ok(_) -> true | Err(_) -> false end
      assert html_exists
      let _ = Dir.rm_rf(tmp)
    end

    test "discovers markdown files in nested subdirectories" do
      let tmp = "/tmp/sigil_nested_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let sub_dir     = Path.join(content_dir, "posts")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = Dir.mkdir_p(sub_dir)
      let _ = File.write(Path.join(content_dir, "top.md"), "# Top\n\nTop body.")
      let _ = File.write(Path.join(sub_dir, "nested.md"), "# Nested\n\nNested body.")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      -- Output mirrors the content tree: content/posts/nested.md -> out/posts/nested.html
      let top_html = match File.read(Path.join(output_dir, "top.html")) do Ok(s) -> s | Err(_) -> "" end
      let nested_html = match File.read(Path.join(Path.join(output_dir, "posts"), "nested.html")) do Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(top_html, "Top"))
      assert (String.contains(nested_html, "Nested"))
      let _ = Dir.rm_rf(tmp)
    end

    test "returns Err when content dir does not exist" do
      let site = { content_dir = "/tmp/sigil_no_such_dir_xyz", output_dir = "/tmp/sigil_out_xyz", static_dir = "/tmp/no_static", title = "", base_url = "" }
      let result = Build.run(site)
      assert (match result do Ok(_) -> false | Err(_) -> true end)
    end

    test "markdown heading renders as h1 in output" do
      let tmp = "/tmp/sigil_md_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"), "# Hello\n\nParagraph text.")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "post.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "<h1"))
      assert (String.contains(html, "Hello"))
      assert (String.contains(html, "<p>"))
      assert (String.contains(html, "Paragraph text."))
      let _ = Dir.rm_rf(tmp)
    end

    test "generates a home index.html listing all posts" do
      let tmp = "/tmp/sigil_index_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "alpha.md"),
                "---\ntitle: Alpha Post\ndate: 2026-01-02\n---\n# Alpha\n\nBody.")
      let _ = File.write(Path.join(content_dir, "beta.md"),
                "---\ntitle: Beta Post\ndate: 2026-02-02\n---\n# Beta\n\nBody.")
      let _ = File.write(Path.join(content_dir, "secret.md"),
                "---\ntitle: Secret Draft\ndate: 2026-03-02\ndraft: true\n---\n# Secret\n\nBody.")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "My Blog", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "index.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      -- full document with the site title
      assert (String.contains(html, "<!DOCTYPE html>"))
      assert (String.contains(html, "My Blog"))
      -- links to each non-draft post
      assert (String.contains(html, "href=\"/alpha.html\""))
      assert (String.contains(html, "Alpha Post"))
      assert (String.contains(html, "href=\"/beta.html\""))
      assert (String.contains(html, "Beta Post"))
      -- drafts excluded
      assert (not(String.contains(html, "Secret Draft")))
      -- NOTE: chronological ordering is intentionally NOT asserted here: it relies
      -- on SiteIndex.sorted_by_date / List.sort_by, which is miscompiled in the
      -- native path (see the KNOWN ISSUE note on SiteIndex.sorted_by_date).
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Ssg.parse_args" do
    -- Simulate compiled argv: ["sigil", "build", ...]
    test "build subcommand returns default site" do
      let argv = Cons("sigil", Cons("build", Nil))
      let result = Ssg.parse_args(argv)
      assert (match result do
              Ok(s) -> Config.site_content_dir(s) == "content" && Config.site_output_dir(s) == "out"
              Err(_) -> false
              end)
    end

    test "flags override defaults" do
      let argv = Cons("sigil", Cons("build",
                   Cons("--content-dir", Cons("src",
                     Cons("--output-dir", Cons("dist", Nil))))))
      let result = Ssg.parse_args(argv)
      assert (match result do
              Ok(s) -> Config.site_content_dir(s) == "src" && Config.site_output_dir(s) == "dist"
              Err(_) -> false
              end)
    end

    test "unknown subcommand returns Err" do
      let argv = Cons("sigil", Cons("serve", Nil))
      let result = Ssg.parse_args(argv)
      assert (match result do Ok(_) -> false | Err(_) -> true end)
    end

    test "serve subcommand returns Err from parse_args (routed separately in main)" do
      let argv = Cons("sigil", Cons("serve", Nil))
      let result = Ssg.parse_args(argv)
      assert (match result do Ok(_) -> false | Err(_) -> true end)
    end

    test "unknown flag returns Err" do
      let argv = Cons("sigil",
                   Cons("build", Cons("--foo", Cons("bar", Nil))))
      let result = Ssg.parse_args(argv)
      assert (match result do Ok(_) -> false | Err(_) -> true end)
    end

    -- Simulate interpreted argv: ["/march", "/path/to/sigil.march", "build", ...]
    test "works when march binary and script are in argv" do
      let argv = Cons("/usr/bin/march",
                   Cons("/path/to/sigil.march", Cons("build", Nil)))
      let result = Ssg.parse_args(argv)
      assert (match result do
              Ok(s) -> Config.site_content_dir(s) == "content" && Config.site_output_dir(s) == "out"
              Err(_) -> false
              end)
    end
  end

  describe "M2" do
    -- ── FrontMatter.split ─────────────────────────────────────────────────────

    test "FrontMatter.split with front-matter returns yaml and body" do
      let content = "---\ntitle: Hello World\ndate: 2026-06-05\n---\n# Hello\n\nContent here."
      let pair    = FrontMatter.split(content)
      let yaml    = match pair do (y, _) -> y end
      let body    = match pair do (_, b) -> b end
      assert (String.contains(yaml, "title: Hello World"))
      assert (String.contains(body, "# Hello"))
      assert (String.contains(body, "Content here."))
    end

    test "FrontMatter.split without front-matter returns empty yaml and full content" do
      let content = "# Just a heading\n\nNo front matter here."
      let pair    = FrontMatter.split(content)
      let yaml    = match pair do (y, _) -> y end
      let body    = match pair do (_, b) -> b end
      assert (yaml == "")
      assert (String.contains(body, "# Just a heading"))
    end

    -- ── Page.decode ───────────────────────────────────────────────────────────

    test "Page.decode reads title from yaml" do
      let yaml = "title: My Post\ndate: 2026-01-01\n"
      let meta = Page.decode("content/my-post.md", yaml)
      assert (meta.title == "My Post")
    end

    test "Page.decode uses slug as default title when no title in yaml" do
      let meta = Page.decode("content/hello-world.md", "")
      assert (meta.title == "hello-world")
    end

    test "Page.decode draft false by default" do
      let meta = Page.decode("content/page.md", "")
      assert (meta.draft == false)
    end

    test "Page.decode reads draft: true from yaml" do
      let yaml = "draft: true\n"
      let meta = Page.decode("content/draft-post.md", yaml)
      assert (meta.draft == true)
    end

    test "Page.decode reads tags list from yaml" do
      let yaml = "tags: [march, ssg]\n"
      let meta = Page.decode("content/tagged.md", yaml)
      assert (match meta.tags do Cons(_, _) -> true | Nil -> false end)
    end

    test "Page.decode layout defaults to default" do
      let meta = Page.decode("content/page.md", "")
      assert (meta.layout == "default")
    end

    -- ── Build.run with front-matter ───────────────────────────────────────────

    test "Build.run page with title in front-matter gets title in HTML" do
      let tmp         = "/tmp/sigil_m2_title_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let static_dir  = Path.join(tmp, "static")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"),
                         "---\ntitle: My Great Post\n---\n\n# Hello\n")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = static_dir, title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "post.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "My Great Post"))
      let _ = Dir.rm_rf(tmp)
    end

    test "Build.run draft: true pages are skipped" do
      let tmp         = "/tmp/sigil_m2_draft_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let static_dir  = Path.join(tmp, "static")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "draft.md"),
                         "---\ndraft: true\n---\n\nSecret content.\n")
      let _ = File.write(Path.join(content_dir, "public.md"),
                         "# Public\n")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = static_dir, title = "", base_url = "" }
      let _ = Build.run(site)
      let draft_exists = match File.read(Path.join(output_dir, "draft.html")) do
                         Ok(_) -> true | Err(_) -> false end
      assert (draft_exists == false)
      let public_exists = match File.read(Path.join(output_dir, "public.html")) do
                          Ok(_) -> true | Err(_) -> false end
      assert (public_exists == true)
      let _ = Dir.rm_rf(tmp)
    end

    -- ── Assets.copy ───────────────────────────────────────────────────────────

    test "Assets.copy copies files from static dir to output dir" do
      let tmp        = "/tmp/sigil_m2_assets_" ++ to_string(System.monotonic_time())
      let static_dir = Path.join(tmp, "static")
      let output_dir = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(static_dir)
      let _ = Dir.mkdir_p(output_dir)
      let _ = File.write(Path.join(static_dir, "style.css"), "body { margin: 0; }")
      let result = Assets.copy(static_dir, output_dir)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let css = match File.read(Path.join(output_dir, "style.css")) do
                Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(css, "margin"))
      let _ = Dir.rm_rf(tmp)
    end

    test "Assets.copy returns Ok when static dir does not exist" do
      let result = Assets.copy("/tmp/sigil_no_static_xyz", "/tmp/sigil_out_xyz")
      assert (match result do Ok(_) -> true | Err(_) -> false end)
    end

    test "Assets.copy mirrors nested subdirectories" do
      let tmp        = "/tmp/sigil_assets_nested_" ++ to_string(System.monotonic_time())
      let static_dir = Path.join(tmp, "static")
      let sub        = Path.join(static_dir, "stdlib")
      let deep       = Path.join(sub, "scroll")
      let output_dir = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(deep)
      let _ = File.write(Path.join(static_dir, "style.css"), "body{}")
      let _ = File.write(Path.join(sub, "Foo.html"), "<h1>Foo</h1>")
      let _ = File.write(Path.join(deep, "List.md"), "scroll source")
      let result = Assets.copy(static_dir, output_dir)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let top    = match File.read(Path.join(output_dir, "style.css")) do Ok(s) -> s | Err(_) -> "" end
      let nested = match File.read(Path.join(Path.join(output_dir, "stdlib"), "Foo.html")) do Ok(s) -> s | Err(_) -> "" end
      let deepf  = match File.read(Path.join(Path.join(Path.join(output_dir, "stdlib"), "scroll"), "List.md")) do Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(top, "body{}"))
      assert (String.contains(nested, "Foo"))
      assert (String.contains(deepf, "scroll source"))
      let _ = Dir.rm_rf(tmp)
    end

    -- ── Config.default with static_dir ───────────────────────────────────────

    test "Config.default has static_dir field" do
      let s = Config.default()
      assert (Config.site_static_dir(s) == "static")
    end
  end

  describe "Watcher" do
    test "version_path returns .sigil-reload in output dir" do
      let p = Watcher.version_path("/tmp/out")
      assert (p == "/tmp/out/.sigil-reload")
    end

    test "read_version returns 0 when file missing" do
      let v = Watcher.read_version("/tmp/no_such_out_xyz")
      assert (v == 0)
    end

    test "write_version then read_version roundtrip" do
      -- RC note: tmp is passed to watcher_roundtrip as a single owned arg so that
      -- all four uses (mkdir, write, read, rm_rf) are sequential uses of a function
      -- parameter.  Perceus handles multi-use function parameters correctly.
      let tmp = "/tmp/sigil_watcher_" ++ to_string(System.monotonic_time())
      assert (watcher_roundtrip(tmp))
    end

    test "max_mtime returns 0 for empty dir" do
      let tmp = "/tmp/sigil_mtime_" ++ to_string(System.monotonic_time())
      let _ = Dir.mkdir_p(tmp)
      let m = Watcher.max_mtime(tmp)
      assert (m == 0)
      let _ = Dir.rm_rf(tmp)
    end

    test "max_mtime returns nonzero after writing a file" do
      let tmp = "/tmp/sigil_mtime2_" ++ to_string(System.monotonic_time())
      let _ = Dir.mkdir_p(tmp)
      let _ = File.write(Path.join(tmp, "post.md"), "# Hello")
      let m = Watcher.max_mtime(tmp)
      assert (m > 0)
      let _ = Dir.rm_rf(tmp)
    end

    test "count_tree counts all files recursively (for delete detection)" do
      let tmp = "/tmp/sigil_count_" ++ to_string(System.monotonic_time())
      let sub = Path.join(tmp, "nested")
      let _ = Dir.mkdir_p(sub)
      let _ = File.write(Path.join(tmp, "a.md"), "1")
      let _ = File.write(Path.join(tmp, "b.css"), "2")
      let _ = File.write(Path.join(sub, "c.html"), "3")
      assert (Watcher.count_tree(tmp) == 3)
      let _ = File.write(Path.join(tmp, "b.css"), "")   -- truncate, not delete
      let _ = Dir.rm_rf(Path.join(tmp, "b.css"))
      assert (Watcher.count_tree(tmp) == 2)
      let _ = Dir.rm_rf(tmp)
    end

    test "max_mtime_tree sees non-md files in nested subdirs (static assets)" do
      let tmp = "/tmp/sigil_mtree_" ++ to_string(System.monotonic_time())
      let sub = Path.join(tmp, "css")
      let _ = Dir.mkdir_p(sub)
      let _ = File.write(Path.join(sub, "style.css"), "body{}")
      let m = Watcher.max_mtime_tree(tmp)
      -- max_mtime (md-only) ignores the .css; max_mtime_tree must see it
      let m_md = Watcher.max_mtime(tmp)
      assert (m > 0)
      assert (m_md == 0)
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Serve" do
    test "inject_reload adds script before closing body tag" do
      let html   = "<!DOCTYPE html><html><body><p>hi</p></body></html>"
      let result = Serve.inject_reload(html)
      assert (String.contains(result, "<script>"))
      assert (String.contains(result, "WebSocket"))
      assert (String.contains(result, "</body>"))
      let script_pos = match String.index_of(result, "<script>") do
                       Some(n) -> n | None -> 9999 end
      let body_pos   = match String.index_of(result, "</body>") do
                       Some(n) -> n | None -> 0 end
      assert (script_pos < body_pos)
    end

    test "inject_reload is a no-op when no closing body tag" do
      let html   = "<p>no body tag</p>"
      let result = Serve.inject_reload(html)
      assert (String.contains(result, "<p>no body tag</p>"))
      assert (not (String.contains(result, "<script>")))
    end

    test "get_content_dir reads SIGIL_CONTENT_DIR env var" do
      let _ = System.put_env("SIGIL_CONTENT_DIR", "/tmp/sigil_cdir_test")
      let d = Watcher.get_content_dir()
      assert (d == "/tmp/sigil_cdir_test")
    end

    test "safe_slug rejects path traversal" do
      assert (not(Serve.safe_slug("../secret")))
      assert (not(Serve.safe_slug("..")))
      assert (not(Serve.safe_slug("a/../b")))
      assert (not(Serve.safe_slug("/etc/passwd")))
      assert (not(Serve.safe_slug("a\\b")))
      assert (not(Serve.safe_slug("")))
    end

    test "safe_slug allows normal and nested slugs" do
      assert (Serve.safe_slug("index"))
      assert (Serve.safe_slug("docs/intro"))
      assert (Serve.safe_slug("a-b_c"))
    end
  end

  describe "Build.run_with_layout" do
    test "custom layout wraps content with its own HTML structure" do
      let tmp = "/tmp/sigil_m3a_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "hello.md"), "# Hello\n\nContent.")
      let build_cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let lf = Build.LayoutFn(fn page -> fn content ->
        IOList.from_string("<html data-custom=\"yes\">")
        |> IOList.append(content)
        |> IOList.append(IOList.from_string("</html>"))
      )
      let result = Build.run_with_layout(build_cfg, lf)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let html = match File.read(Path.join(output_dir, "hello.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "data-custom=\"yes\""))
      assert (not (String.contains(html, "<!DOCTYPE html>")))
      let _ = Dir.rm_rf(tmp)
    end

    test "layout receives the page slug via Page.Meta" do
      let tmp = "/tmp/sigil_slug_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let docs_dir    = Path.join(content_dir, "docs")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(docs_dir)
      let _ = File.write(Path.join(docs_dir, "intro.md"), "# Intro")
      let build_cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let lf = Build.LayoutFn(fn page -> fn content ->
        IOList.from_string("<html data-slug=\"" ++ Page.meta_slug(page) ++ "\">")
        |> IOList.append(content)
        |> IOList.append(IOList.from_string("</html>"))
      )
      let _ = Build.run_with_layout(build_cfg, lf)
      let html = match File.read(Path.join(Path.join(output_dir, "docs"), "intro.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "data-slug=\"docs/intro\""))
      let _ = Dir.rm_rf(tmp)
    end

    test "layout receives page title via Page.Meta" do
      let tmp = "/tmp/sigil_m3b_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"), "# Post Title")
      let build_cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      -- Site name captured as a plain string to avoid Perceus cross-module record RC underflow.
      let site_name = "Sigil Tests"
      let lf = Build.LayoutFn(fn page -> fn content ->
        IOList.from_string("<html><title>" ++ Page.meta_title(page) ++ " | " ++ site_name ++ "</title></html>")
      )
      let _ = Build.run_with_layout(build_cfg, lf)
      let html = match File.read(Path.join(output_dir, "post.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "Sigil Tests"))
      assert (String.contains(html, "Post Title"))
      let _ = Dir.rm_rf(tmp)
    end

    test "Build.run backward compat still uses Html.layout" do
      let tmp = "/tmp/sigil_m3c_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "page.md"), "hello")
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      let result = Build.run(site)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let html = match File.read(Path.join(output_dir, "page.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "<!DOCTYPE html>"))
      let _ = Dir.rm_rf(tmp)
    end

    test "H1 heading text becomes page.title when no front-matter title set" do
      let tmp = "/tmp/sigil_m3_h1_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      -- No front-matter title: only a heading in the body
      let _ = File.write(Path.join(content_dir, "article.md"), "# My Great Article\n\nSome content.")
      let build_cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "", base_url = "" }
      -- Capture the page.title as seen by the layout
      let lf = Build.LayoutFn(fn page -> fn content ->
        IOList.from_string("<title>" ++ Page.meta_title(page) ++ "</title>")
      )
      let _ = Build.run_with_layout(build_cfg, lf)
      let html = match File.read(Path.join(output_dir, "article.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      -- Should be H1 text, not the slug "article"
      assert (String.contains(html, "<title>My Great Article</title>"))
      assert (not (String.contains(html, "<title>article</title>")))
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "M4 Debug" do
    test "dedup on ints works" do
      let xs = Cons(1, Cons(2, Cons(2, Cons(3, Nil))))
      let u  = List.dedup(xs)
      assert (List.length(u) == 3)
    end

    test "dedup on strings works" do
      -- List.dedup uses pointer equality for strings (misses semantic dups).
      -- Use SiteIndex.unique_strs which uses < for comparison.
      let xs = Cons("ssg", Cons("march", Cons("march", Cons("tutorial", Nil))))
      let u  = SiteIndex.unique_strs(xs)
      assert (List.length(u) == 3)
    end

    test "dedup on strings no dups" do
      let xs = Cons("a", Cons("b", Cons("c", Nil)))
      let u  = List.dedup(xs)
      assert (List.length(u) == 3)
    end

    test "dedup removes consecutive dups" do
      let xs = Cons("a", Cons("a", Nil))
      let u  = SiteIndex.unique_strs(xs)
      assert (List.length(u) == 1)
    end

    test "sort_by strings a < b works" do
      let xs = Cons("ssg", Cons("march", Cons("tutorial", Nil)))
      let s  = List.sort_by(xs, fn (a, b) -> a < b)
      assert (List.length(s) == 3)
    end

    test "entry_tags returns full list" do
      let m   = Page.decode("content/a.md", "tags: [ssg, march]\n")
      let idx = SiteIndex.add(SiteIndex.empty(), "a", "", m)
      let es  = SiteIndex.entries(idx)
      let ts  = match es do Cons(e, _) -> SiteIndex.entry_tags(e) | Nil -> Nil end
      assert (List.length(ts) == 2)
    end

    test "flat_map entry_tags gives all tags" do
      let m1  = Page.decode("content/a.md", "tags: [ssg, march]\n")
      let m2  = Page.decode("content/b.md", "tags: [march, tutorial]\n")
      let idx = SiteIndex.add(SiteIndex.add(SiteIndex.empty(), "a", "", m1), "b", "", m2)
      let es  = SiteIndex.entries(idx)
      let all = List.flat_map(es, fn e -> SiteIndex.entry_tags(e))
      assert (List.length(all) == 4)
    end
  end

  describe "M4 SiteIndex" do
    test "empty index has no entries" do
      let idx = SiteIndex.empty()
      let es  = SiteIndex.entries(idx)
      assert (match es do Nil -> true | Cons(_, _) -> false end)
    end

    test "add and entries roundtrip" do
      let idx   = SiteIndex.empty()
      let meta  = Page.decode("content/post.md", "title: Hello\ndate: 2025-01-01\ntags: [march]\n")
      let idx2  = SiteIndex.add(idx, "post", "", meta)
      let es    = SiteIndex.entries(idx2)
      assert (match es do Cons(e, Nil) -> SiteIndex.entry_slug(e) == "post" | _ -> false end)
    end

    test "all_tags returns sorted unique tags" do
      let idx  = SiteIndex.empty()
      let m1   = Page.decode("content/a.md", "tags: [ssg, march]\n")
      let m2   = Page.decode("content/b.md", "tags: [march, tutorial]\n")
      let idx2 = SiteIndex.add(SiteIndex.add(idx, "a", "", m1), "b", "", m2)
      let tags = SiteIndex.all_tags(idx2)
      assert (List.length(tags) == 3)
      assert (List.member(tags, "march"))
      assert (List.member(tags, "ssg"))
      assert (List.member(tags, "tutorial"))
    end

    test "by_tag returns only matching entries" do
      let idx  = SiteIndex.empty()
      let m1   = Page.decode("content/a.md", "tags: [march]\n")
      let m2   = Page.decode("content/b.md", "tags: [ssg]\n")
      let idx2 = SiteIndex.add(SiteIndex.add(idx, "a", "", m1), "b", "", m2)
      let tagged = SiteIndex.by_tag(idx2, "march")
      assert (List.length(tagged) == 1)
      assert (match tagged do Cons(e, _) -> SiteIndex.entry_slug(e) == "a" | Nil -> false end)
    end

    test "sorted_by_date returns newest first" do
      let idx = SiteIndex.empty()
      let m1  = Page.decode("content/old.md", "title: Old\ndate: 2025-01-01\n")
      let m2  = Page.decode("content/new.md", "title: New\ndate: 2025-06-01\n")
      let idx2 = SiteIndex.add(SiteIndex.add(idx, "old", "", m1), "new", "", m2)
      let sorted = SiteIndex.sorted_by_date(idx2)
      assert (match sorted do
              Cons(e, _) -> SiteIndex.entry_slug(e) == "new"
              Nil        -> false
              end)
    end
  end

  describe "SiteConfig" do
    -- (a) sigil.toml values are picked up over the built-in defaults.
    test "load picks up values from sigil.toml" do
      let tmp = "/tmp/sigil_cfg_" ++ to_string(System.monotonic_time())
      let _   = Dir.mkdir_p(tmp)
      let cfg = Path.join(tmp, "sigil.toml")
      let _   = File.write(cfg,
        "[site]\ntitle = \"Toml Site\"\nbase_url = \"https://toml.example\"\n[build]\ncontent_dir = \"src\"\noutput_dir = \"dist\"\nstatic_dir = \"assets\"\n")
      let result = SiteConfig.load(cfg, "content", "out", "static", "My Site", "")
      -- Extract each field with its own accessor call on a freshly destructured
      -- record to avoid Perceus multi-use underflow on a cross-module record.
      let title   = match result do Ok(s) -> Config.site_title(s)       | Err(_) -> "" end
      let result2 = SiteConfig.load(cfg, "content", "out", "static", "My Site", "")
      let base    = match result2 do Ok(s) -> Config.site_base_url(s)    | Err(_) -> "" end
      let result3 = SiteConfig.load(cfg, "content", "out", "static", "My Site", "")
      let cdir    = match result3 do Ok(s) -> Config.site_content_dir(s) | Err(_) -> "" end
      let result4 = SiteConfig.load(cfg, "content", "out", "static", "My Site", "")
      let odir    = match result4 do Ok(s) -> Config.site_output_dir(s)  | Err(_) -> "" end
      let result5 = SiteConfig.load(cfg, "content", "out", "static", "My Site", "")
      let sdir    = match result5 do Ok(s) -> Config.site_static_dir(s)  | Err(_) -> "" end
      assert (title == "Toml Site")
      assert (base == "https://toml.example")
      assert (cdir == "src")
      assert (odir == "dist")
      assert (sdir == "assets")
      let _ = Dir.rm_rf(tmp)
    end

    -- Keys absent from sigil.toml fall back to the supplied defaults.
    test "load falls back to defaults for missing keys" do
      let tmp = "/tmp/sigil_cfg_partial_" ++ to_string(System.monotonic_time())
      let _   = Dir.mkdir_p(tmp)
      let cfg = Path.join(tmp, "sigil.toml")
      let _   = File.write(cfg, "[site]\ntitle = \"Only Title\"\n")
      let result = SiteConfig.load(cfg, "content", "out", "static", "Default Title", "")
      assert (match result do
              Ok(s) ->
                Config.site_title(s) == "Only Title" &&
                Config.site_content_dir(s) == "content" &&
                Config.site_output_dir(s) == "out"
              Err(_) -> false
              end)
      let _ = Dir.rm_rf(tmp)
    end

    -- (b) a CLI flag overrides a value coming from the config file.
    test "CLI flag overrides config file value" do
      let tmp = "/tmp/sigil_cfg_override_" ++ to_string(System.monotonic_time())
      let _   = Dir.mkdir_p(tmp)
      let cfg = Path.join(tmp, "sigil.toml")
      let _   = File.write(cfg, "[build]\ncontent_dir = \"from_toml\"\noutput_dir = \"out_toml\"\n")
      -- Seed defaults from the config file, exactly as Ssg.parse_args does.
      let seeded = SiteConfig.load(cfg, "content", "out", "static", "My Site", "")
      let result = match seeded do
        Ok(seed) ->
          -- Then apply CLI flags on top; --content-dir should win over the toml value.
          Ssg.parse_flags(Cons("--content-dir", Cons("from_flag", Nil)),
                          Config.site_content_dir(seed), Config.site_output_dir(seed),
                          Config.site_static_dir(seed), Config.site_title(seed), Config.site_base_url(seed))
        Err(m) -> Err(m)
      end
      assert (match result do
              Ok(s) ->
                -- flag wins for content_dir, toml still wins for output_dir (no flag given)
                Config.site_content_dir(s) == "from_flag" &&
                Config.site_output_dir(s) == "out_toml"
              Err(_) -> false
              end)
      let _ = Dir.rm_rf(tmp)
    end

    -- (c) a missing config file silently falls back to the supplied defaults.
    test "load falls back to defaults when file is missing" do
      let missing = "/tmp/sigil_cfg_nope_" ++ to_string(System.monotonic_time()) ++ "/sigil.toml"
      let result = SiteConfig.load(missing, "content", "out", "static", "My Site", "")
      assert (match result do
              Ok(s) ->
                Config.site_content_dir(s) == "content" &&
                Config.site_output_dir(s) == "out" &&
                Config.site_title(s) == "My Site"
              Err(_) -> false
              end)
    end

    -- The line parser is lenient by design (the stdlib Toml backend was dropped to
    -- dodge a native miscompilation — see SiteConfig): unparseable / partial lines
    -- are skipped rather than failing the whole load, and valid keys still parse.
    test "load tolerates malformed lines and still parses valid keys" do
      let tmp = "/tmp/sigil_cfg_bad_" ++ to_string(System.monotonic_time())
      let _   = Dir.mkdir_p(tmp)
      let cfg = Path.join(tmp, "sigil.toml")
      let _   = File.write(cfg, "this is not toml\n[site]\ntitle = \"Recovered\"\n= orphan\n")
      let result = SiteConfig.load(cfg, "content", "out", "static", "Default", "")
      assert (match result do
              Err(_)   -> false
              Ok(site) -> String.contains(Config.site_title(site), "Recovered")
              end)
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Per-page layout" do
    test "layout: post renders distinctive markup absent from layout: default" do
      let tmp         = "/tmp/sigil_layout_sel_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      -- One page explicitly using the default layout, one using the post layout.
      let _ = File.write(Path.join(content_dir, "plain.md"),
                         "---\ntitle: Plain Page\nlayout: default\n---\n\nPlain body.")
      let _ = File.write(Path.join(content_dir, "story.md"),
                         "---\ntitle: My Story\ndate: 2026-01-02\nlayout: post\n---\n\nStory body.")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let plain_html = match File.read(Path.join(output_dir, "plain.html")) do
                       Ok(s) -> s | Err(_) -> "" end
      let story_html = match File.read(Path.join(output_dir, "story.html")) do
                       Ok(s) -> s | Err(_) -> "" end
      -- Both are full HTML documents.
      assert (String.contains(plain_html, "<!DOCTYPE html>"))
      assert (String.contains(story_html, "<!DOCTYPE html>"))
      -- The post layout adds a distinctive <header class="post-header"> with the
      -- title as an <h1 class="post-title"> and the date in a <time> element.
      assert (String.contains(story_html, "<header class=\"post-header\">"))
      assert (String.contains(story_html, "<h1 class=\"post-title\">My Story</h1>"))
      assert (String.contains(story_html, "<time class=\"post-date\">2026-01-02</time>"))
      -- The default layout has none of that markup.
      assert (not (String.contains(plain_html, "post-header")))
      assert (not (String.contains(plain_html, "post-title")))
      let _ = Dir.rm_rf(tmp)
    end

    test "layout: post with no date omits the <time> element" do
      let tmp         = "/tmp/sigil_layout_nodate_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "undated.md"),
                         "---\ntitle: Undated Post\nlayout: post\n---\n\nBody.")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "undated.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      -- The post header and title are present, but there is no <time> element.
      assert (String.contains(html, "<h1 class=\"post-title\">Undated Post</h1>"))
      assert (not (String.contains(html, "<time")))
      let _ = Dir.rm_rf(tmp)
    end

    test "unknown layout name falls back to default wrapper" do
      let tmp         = "/tmp/sigil_layout_unknown_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "weird.md"),
                         "---\ntitle: Weird\nlayout: nonesuch\n---\n\nBody.")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(output_dir, "weird.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "<!DOCTYPE html>"))
      assert (not (String.contains(html, "post-header")))
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "M4 Build collections" do
    test "Build.run generates sitemap.xml" do
      let tmp         = "/tmp/sigil_m4_sitemap_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "hello.md"),
                         "---\ntitle: Hello\ndate: 2025-01-01\n---\n# Hello\n")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "My Blog", base_url = "https://example.com" }
      let _ = Build.run(site)
      let xml = match File.read(Path.join(output_dir, "sitemap.xml")) do
                Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(xml, "<urlset"))
      assert (String.contains(xml, "hello.html"))
      let _ = Dir.rm_rf(tmp)
    end

    test "Build.run generates feed.xml with site title" do
      let tmp         = "/tmp/sigil_m4_feed_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"),
                         "---\ntitle: My Post\ndate: 2025-02-01\n---\n# My Post\n")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "Blog Title", base_url = "https://example.com" }
      let _ = Build.run(site)
      let xml = match File.read(Path.join(output_dir, "feed.xml")) do
                Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(xml, "<rss"))
      assert (String.contains(xml, "Blog Title"))
      assert (String.contains(xml, "My Post"))
      let _ = Dir.rm_rf(tmp)
    end

    test "Build.run feed.xml includes post content as CDATA description" do
      let tmp         = "/tmp/sigil_m4_feeddesc_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"),
                         "---\ntitle: My Post\ndate: 2025-02-01\n---\n# My Post\n\nThis is the very first paragraph of the body.\n")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "Blog Title", base_url = "https://example.com" }
      let _ = Build.run(site)
      let xml = match File.read(Path.join(output_dir, "feed.xml")) do
                Ok(s) -> s | Err(_) -> "" end
      -- channel-level description
      assert (String.contains(xml, "Recent posts from Blog Title"))
      -- item-level description wrapped in CDATA with the first paragraph text
      assert (String.contains(xml, "<description"))
      assert (String.contains(xml, "<![CDATA["))
      assert (String.contains(xml, "]]>"))
      assert (String.contains(xml, "This is the very first paragraph of the body."))
      let _ = Dir.rm_rf(tmp)
    end

    test "Build.run generates tag index page" do
      let tmp         = "/tmp/sigil_m4_tags_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"),
                         "---\ntitle: Tagged Post\ntags: [march]\n---\n# Tagged Post\n")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(Path.join(output_dir, "tag"), "march.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "march"))
      assert (String.contains(html, "Tagged Post"))
      let _ = Dir.rm_rf(tmp)
    end

    test "draft pages are excluded from site index" do
      let tmp         = "/tmp/sigil_m4_draft_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "draft.md"),
                         "---\ntitle: Draft\ndraft: true\ntags: [secret]\n---\nSecret.\n")
      let _ = File.write(Path.join(content_dir, "public.md"),
                         "---\ntitle: Public\ntags: [open]\n---\n# Public\n")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "", base_url = "" }
      let _ = Build.run(site)
      let secret_exists = match File.read(Path.join(Path.join(output_dir, "tag"), "secret.html")) do
                          Ok(_) -> true | Err(_) -> false end
      let open_exists   = match File.read(Path.join(Path.join(output_dir, "tag"), "open.html")) do
                          Ok(_) -> true | Err(_) -> false end
      assert (secret_exists == false)
      assert (open_exists == true)
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Scaffold.create" do
    test "creates content, static, sigil.toml, README" do
      let tmp = "/tmp/sigil_scaffold_" ++ to_string(System.monotonic_time())
      let result = Scaffold.create(tmp)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let post_exists = match File.read(Path.join(Path.join(tmp, "content"), "hello-world.md")) do
                        Ok(_) -> true | Err(_) -> false end
      let css_exists  = match File.read(Path.join(Path.join(tmp, "static"), "style.css")) do
                        Ok(_) -> true | Err(_) -> false end
      let toml_exists = match File.read(Path.join(tmp, "sigil.toml")) do
                        Ok(_) -> true | Err(_) -> false end
      let readme_exists = match File.read(Path.join(tmp, "README.md")) do
                          Ok(_) -> true | Err(_) -> false end
      assert post_exists
      assert css_exists
      assert toml_exists
      assert readme_exists
      let _ = Dir.rm_rf(tmp)
    end

    test "sample post contains valid front-matter" do
      let tmp = "/tmp/sigil_scaffold_fm_" ++ to_string(System.monotonic_time())
      let _ = Scaffold.create(tmp)
      let post = match File.read(Path.join(Path.join(tmp, "content"), "hello-world.md")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(post, "---"))
      assert (String.contains(post, "title: Hello World"))
      assert (String.contains(post, "layout: default"))
      assert (String.contains(post, "tags: [hello, sigil]"))
      assert (String.contains(post, "draft: false"))
      let _ = Dir.rm_rf(tmp)
    end

    test "sigil.toml has site and build sections" do
      let tmp = "/tmp/sigil_scaffold_toml_" ++ to_string(System.monotonic_time())
      let _ = Scaffold.create(tmp)
      let toml = match File.read(Path.join(tmp, "sigil.toml")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(toml, "[site]"))
      assert (String.contains(toml, "[build]"))
      assert (String.contains(toml, "content_dir"))
      let _ = Dir.rm_rf(tmp)
    end

    test "refuses when target dir already exists" do
      let tmp = "/tmp/sigil_scaffold_exists_" ++ to_string(System.monotonic_time())
      let _ = Dir.mkdir_p(tmp)
      let result = Scaffold.create(tmp)
      assert (match result do Ok(_) -> false | Err(_) -> true end)
      let _ = Dir.rm_rf(tmp)
    end

    test "scaffolded post drives a working build" do
      let tmp = "/tmp/sigil_scaffold_build_" ++ to_string(System.monotonic_time())
      let _ = Scaffold.create(tmp)
      let site = { content_dir = Path.join(tmp, "content"),
                   output_dir = Path.join(tmp, "out"),
                   static_dir = Path.join(tmp, "static"),
                   title = "My Site", base_url = "" }
      let result = Build.run(site)
      assert (match result do Ok(_) -> true | Err(_) -> false end)
      let html_exists = match File.read(Path.join(Path.join(tmp, "out"), "hello-world.html")) do
                        Ok(_) -> true | Err(_) -> false end
      assert html_exists
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "PathUtil.link_prefix" do
    test "empty base_url has no prefix" do
      assert (PathUtil.link_prefix("") == "")
    end
    test "domain root has no prefix" do
      assert (PathUtil.link_prefix("https://example.com") == "")
    end
    test "trailing slash on domain root has no prefix" do
      assert (PathUtil.link_prefix("https://example.com/") == "")
    end
    test "project subpath yields a leading-slash prefix" do
      assert (PathUtil.link_prefix("https://org.github.io/march") == "/march")
    end
    test "subpath trailing slash is stripped" do
      assert (PathUtil.link_prefix("https://org.github.io/march/") == "/march")
    end
    test "nested subpath is preserved" do
      assert (PathUtil.link_prefix("https://org.github.io/a/b") == "/a/b")
    end
  end

  describe "Build subpath links" do
    test "home index links are base_url-prefixed" do
      let tmp = "/tmp/sigil_prefix_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "hello.md"),
                "---\ntitle: Hello\ndate: 2026-01-01\ntags: [x]\n---\nbody")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "March",
                   base_url = "https://org.github.io/march" }
      let _ = Build.run(site)
      let idx = match File.read(Path.join(output_dir, "index.html")) do
                Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(idx, "href=\"/march/hello.html\""))
      let _ = Dir.rm_rf(tmp)
    end
    test "tag page links are base_url-prefixed" do
      let tmp = "/tmp/sigil_tagprefix_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "hello.md"),
                "---\ntitle: Hello\ndate: 2026-01-01\ntags: [x]\n---\nbody")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "March",
                   base_url = "https://org.github.io/march" }
      let _ = Build.run(site)
      let tagp = match File.read(Path.join(Path.join(output_dir, "tag"), "x.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(tagp, "href=\"/march/hello.html\""))
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Build base_url normalization" do
    test "trailing-slash base_url does not double the slash in sitemap/feed" do
      let tmp = "/tmp/sigil_baseurl_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"), "---\ntitle: P\ndate: 2026-01-01\n---\nbody")
      let cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "March", base_url = "https://example.com/march/" }
      let _ = Build.run(cfg)
      let sm = match File.read(Path.join(output_dir, "sitemap.xml")) do Ok(s) -> s | Err(_) -> "" end
      let fd = match File.read(Path.join(output_dir, "feed.xml")) do Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(sm, "https://example.com/march/post.html"))
      assert (not(String.contains(sm, "march//post")))
      assert (not(String.contains(fd, "march//post")))
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Build.run_pages (docs mode)" do
    test "skips blog collections and keeps the content index.html" do
      let tmp = "/tmp/sigil_docs_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "index.md"), "# Landing\n\nHomeMarker body")
      let cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "March", base_url = "" }
      let lf = Build.LayoutFn(fn page -> fn content ->
        IOList.from_string("<main>") |> IOList.append(content) |> IOList.append(IOList.from_string("</main>")))
      let _ = Build.run_pages_with_layout(cfg, lf)
      -- index.html is the rendered landing page, not an auto archive
      let idx = match File.read(Path.join(output_dir, "index.html")) do Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(idx, "HomeMarker"))
      -- no blog feed generated in docs mode
      let feed_exists = match File.read(Path.join(output_dir, "feed.xml")) do Ok(_) -> true | Err(_) -> false end
      assert (not(feed_exists))
      let _ = Dir.rm_rf(tmp)
    end

    test "run_with_layout (blog mode) still generates feed.xml" do
      let tmp = "/tmp/sigil_blog_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(content_dir)
      let _ = File.write(Path.join(content_dir, "post.md"), "# Post\n\nbody")
      let cfg = { content_dir = content_dir, output_dir = output_dir, static_dir = "/tmp/no_static", title = "March", base_url = "" }
      let lf = Build.LayoutFn(fn page -> fn content -> content)
      let _ = Build.run_with_layout(cfg, lf)
      let feed_exists = match File.read(Path.join(output_dir, "feed.xml")) do Ok(_) -> true | Err(_) -> false end
      assert feed_exists
      let _ = Dir.rm_rf(tmp)
    end
  end

  describe "Page.Meta fields" do
    test "decode parses nav_order and description" do
      let m = Page.decode("x.md", "title: T\nnav_order: 7\ndescription: hello there\n")
      assert (Page.meta_nav_order(m) == 7)
      assert (Page.meta_description(m) == "hello there")
    end
    test "decode defaults nav_order to 0 and description to empty" do
      let m = Page.decode("x.md", "title: T\n")
      assert (Page.meta_nav_order(m) == 0)
      assert (Page.meta_description(m) == "")
    end
    test "non-numeric nav_order falls back to 0" do
      let m = Page.decode("x.md", "nav_order: oops\n")
      assert (Page.meta_nav_order(m) == 0)
    end
    test "with_slug sets the slug accessor" do
      let m  = Page.decode("x.md", "title: T\n")
      let m2 = Page.with_slug(m, "docs/intro")
      assert (Page.meta_slug(m2) == "docs/intro")
    end
    test "with_title preserves nav_order and description" do
      let m  = Page.decode("x.md", "nav_order: 3\ndescription: d\n")
      let m2 = Page.with_title(m, "New")
      assert (Page.meta_title(m2) == "New")
      assert (Page.meta_nav_order(m2) == 3)
      assert (Page.meta_description(m2) == "d")
    end
  end

  describe "Build.rel_slug" do
    test "top-level file keeps its slug" do
      assert (Build.rel_slug("content", "content/hello.md") == "hello")
    end
    test "nested file mirrors its subdirectory" do
      assert (Build.rel_slug("content", "content/docs/intro.md") == "docs/intro")
    end
    test "trailing slash on root is tolerated" do
      assert (Build.rel_slug("content/", "content/docs/intro.md") == "docs/intro")
    end
    test "path outside root falls back to basename" do
      assert (Build.rel_slug("content", "/elsewhere/x.md") == "x")
    end
  end

  describe "Build nested output" do
    test "subdirectory structure is mirrored into output" do
      let tmp = "/tmp/sigil_nested_" ++ to_string(System.monotonic_time())
      let content_dir = Path.join(tmp, "content")
      let docs_dir    = Path.join(content_dir, "docs")
      let output_dir  = Path.join(tmp, "out")
      let _ = Dir.mkdir_p(docs_dir)
      let _ = File.write(Path.join(docs_dir, "intro.md"), "# Intro\nbody")
      let site = { content_dir = content_dir, output_dir = output_dir,
                   static_dir = "/tmp/no_static", title = "M", base_url = "" }
      let _ = Build.run(site)
      let html = match File.read(Path.join(Path.join(output_dir, "docs"), "intro.html")) do
                 Ok(s) -> s | Err(_) -> "" end
      assert (String.contains(html, "Intro"))
      let _ = Dir.rm_rf(tmp)
    end
  end

end
