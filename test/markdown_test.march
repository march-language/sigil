mod TestMd do

  describe "MdRender" do
    test "renders Para with text" do
      let blocks = Cons(Para(Cons(Inline.Text("hello"), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<p>hello</p>"))
    end

    test "escapes special chars in Text" do
      let blocks = Cons(Para(Cons(Inline.Text("<b>&foo</b>"), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "&lt;b&gt;&amp;foo&lt;/b&gt;"))
      assert (not (String.contains(html, "<b>")))
    end

    test "renders Heading level 1" do
      let blocks = Cons(Heading(1, "hello-world", Cons(Inline.Text("Hello World"), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<h1"))
      assert (String.contains(html, "id=\"hello-world\""))
      assert (String.contains(html, "Hello World"))
      assert (String.contains(html, "</h1>"))
    end

    test "renders Heading level 3" do
      let blocks = Cons(Heading(3, "sec", Cons(Inline.Text("Sec"), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<h3"))
      assert (String.contains(html, "</h3>"))
    end

    test "renders CodeBlock with language" do
      let blocks = Cons(CodeBlock("march", "fn f(x) do x end"), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<pre><code"))
      assert (String.contains(html, "language-march"))
      assert (String.contains(html, "fn f(x) do x end"))
      assert (String.contains(html, "</code></pre>"))
    end

    test "escapes code block body" do
      let blocks = Cons(CodeBlock("", "<script>alert(1)</script>"), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "&lt;script&gt;"))
      assert (not (String.contains(html, "<script>")))
    end

    test "renders ThematicBreak" do
      let blocks = Cons(ThematicBreak, Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<hr"))
    end

    test "renders inline Code" do
      let blocks = Cons(Para(Cons(Code("x + 1"), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<code>x + 1</code>"))
    end

    test "renders multiple blocks in sequence" do
      let blocks = Cons(Heading(1, "h", Cons(Inline.Text("H"), Nil)),
                   Cons(Para(Cons(Inline.Text("p"), Nil)),
                   Cons(ThematicBreak, Nil)))
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<h1"))
      assert (String.contains(html, "<p>"))
      assert (String.contains(html, "<hr"))
    end
  end

  describe "MdRender additional variants" do
    test "renders Emph" do
      let blocks = Cons(Para(Cons(Emph(Cons(Inline.Text("hi"), Nil)), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<em>hi</em>"))
    end

    test "renders Strong" do
      let blocks = Cons(Para(Cons(Strong(Cons(Inline.Text("bold"), Nil)), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<strong>bold</strong>"))
    end

    test "renders Link" do
      let blocks = Cons(Para(Cons(Link("https://example.com", "", Cons(Inline.Text("click"), Nil)), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<a href=\"https://example.com\""))
      assert (String.contains(html, "click</a>"))
    end

    test "javascript: URL in Link is sanitized" do
      let blocks = Cons(Para(Cons(Link("javascript:alert(1)", "", Cons(Inline.Text("x"), Nil)), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (not (String.contains(html, "javascript:")))
    end

    test "disallowed schemes (vbscript/data/file) are neutralized" do
      let mk = fn u -> Cons(Para(Cons(Link(u, "", Cons(Inline.Text("x"), Nil)), Nil)), Nil)
      let vb = IOList.to_string(MdRender.render(mk("vbscript:msgbox(1)")))
      let dt = IOList.to_string(MdRender.render(mk("data:text/html,<script>1</script>")))
      let fl = IOList.to_string(MdRender.render(mk("file:///etc/passwd")))
      assert (not (String.contains(vb, "vbscript:")))
      assert (not (String.contains(dt, "data:")))
      assert (not (String.contains(fl, "file:")))
    end

    test "allowed schemes and relative URLs pass through" do
      let mk = fn u -> Cons(Para(Cons(Link(u, "", Cons(Inline.Text("x"), Nil)), Nil)), Nil)
      let https = IOList.to_string(MdRender.render(mk("https://example.com/a")))
      let mail  = IOList.to_string(MdRender.render(mk("mailto:a@b.com")))
      let rel   = IOList.to_string(MdRender.render(mk("docs/intro.html")))
      let abs   = IOList.to_string(MdRender.render(mk("/march/x.html")))
      let frag  = IOList.to_string(MdRender.render(mk("#section")))
      assert (String.contains(https, "href=\"https://example.com/a\""))
      assert (String.contains(mail, "href=\"mailto:a@b.com\""))
      assert (String.contains(rel, "href=\"docs/intro.html\""))
      assert (String.contains(abs, "href=\"/march/x.html\""))
      assert (String.contains(frag, "href=\"#section\""))
    end

    test "renders Image" do
      let blocks = Cons(Para(Cons(Image("https://example.com/img.png", "alt text", ""), Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<img src=\"https://example.com/img.png\""))
      assert (String.contains(html, "alt=\"alt text\""))
    end

    test "renders HardBreak" do
      let blocks = Cons(Para(Cons(HardBreak, Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<br>"))
    end

    test "renders BulletList" do
      let item = Cons(Para(Cons(Inline.Text("item"), Nil)), Nil)
      let blocks = Cons(BulletList(Cons(item, Nil)), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<ul>"))
      assert (String.contains(html, "<li>"))
    end

    test "renders Quote" do
      let inner = Cons(Para(Cons(Inline.Text("quoted"), Nil)), Nil)
      let blocks = Cons(Quote(inner), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<blockquote>"))
    end

    test "renders RawHtml passthrough" do
      let blocks = Cons(RawHtml("<div class=\"custom\">raw</div>"), Nil)
      let html = IOList.to_string(MdRender.render(blocks))
      assert (String.contains(html, "<div class=\"custom\">raw</div>"))
    end
  end

  describe "Markdown nested lists" do
    test "indented bullets form a nested sub-list" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("- a\n  - b\n  - c\n- d")))
      assert (String.contains(html, "</ul></li>"))
      assert (String.contains(html, "<li>"))
    end
    test "flat list has no nesting" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("- a\n- b")))
      assert (not (String.contains(html, "</ul></li>")))
      assert (String.contains(html, "<li>"))
    end
    test "two levels of nesting" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("- a\n  - b\n    - c")))
      assert (String.contains(html, "</ul></li></ul></li>"))
    end
  end

  describe "Markdown setext headings" do
    test "equals underline makes an h1" do
      let blocks = MdBlock.parse("My Title\n===")
      assert (match blocks do Cons(Heading(1, _, _), Nil) -> true | _ -> false end)
    end
    test "dash underline makes an h2" do
      let blocks = MdBlock.parse("Subtitle\n---")
      assert (match blocks do Cons(Heading(2, _, _), Nil) -> true | _ -> false end)
    end
    test "dashes with no preceding paragraph stay a thematic break" do
      let blocks = MdBlock.parse("---")
      assert (match blocks do Cons(ThematicBreak, Nil) -> true | _ -> false end)
    end
    test "setext heading renders text in the tag" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("Hello World\n===")))
      assert (String.contains(html, "<h1"))
      assert (String.contains(html, "Hello World"))
    end
  end

  describe "Markdown autolinks" do
    test "absolute URL autolink" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("see <https://example.com> now")))
      assert (String.contains(html, "<a href=\"https://example.com\">https://example.com</a>"))
    end
    test "email autolink becomes mailto" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("mail <a@b.com> please")))
      assert (String.contains(html, "href=\"mailto:a@b.com\""))
      assert (String.contains(html, ">a@b.com</a>"))
    end
    test "non-url angle brackets stay literal" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("x < y > z")))
      assert (String.contains(html, "&lt; y &gt;"))
      assert (not (String.contains(html, "<a ")))
    end
    test "dangerous scheme autolink is rejected" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("<javascript://alert>")))
      assert (not (String.contains(html, "<a ")))
    end
  end

  describe "Markdown emphasis flanking" do
    test "intra-word underscores stay literal (snake_case)" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("call my_var_name now")))
      assert (String.contains(html, "my_var_name"))
      assert (not (String.contains(html, "<em>")))
    end
    test "underscore emphasis at a word boundary still works" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("_hi_ there")))
      assert (String.contains(html, "<em>hi</em>"))
    end
    test "underscore closer followed by a letter does not close" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("a _b_c_ d")))
      -- closer after "b" is followed by "c" (alnum) so it can't close; the next
      -- valid closer is the one before " d".
      assert (String.contains(html, "<em>b_c</em>"))
    end
    test "asterisk intra-word still emphasizes (CommonMark allows it)" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("a*b*c")))
      assert (String.contains(html, "<em>b</em>"))
    end
  end

  describe "Markdown backslash escapes" do
    test "escaped asterisk is literal, not emphasis" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("a \\*b\\* c")))
      assert (String.contains(html, "*b*"))
      assert (not (String.contains(html, "<em>")))
    end
    test "escaped underscore is literal, not emphasis" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("snake\\_case\\_here")))
      assert (String.contains(html, "snake_case_here"))
      assert (not (String.contains(html, "<em>")))
    end
    test "escaped backtick is literal, not code" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("\\`not code\\`")))
      assert (String.contains(html, "`not code`"))
      assert (not (String.contains(html, "<code>")))
    end
    test "backslash before a non-punctuation char is preserved literally" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("a\\bc")))
      assert (String.contains(html, "a\\bc"))
    end
    test "escapes work inside emphasis spans" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("*x\\*y*")))
      assert (String.contains(html, "<em>"))
      assert (String.contains(html, "x*y"))
    end
  end

  describe "MdInline.parse" do
    test "plain text becomes single Text node" do
      let result = MdInline.parse("hello world")
      let ok = match result do
        Cons(Inline.Text(s), Nil) -> s == "hello world"
        _ -> false
      end
      assert ok
    end

    test "empty string returns empty list" do
      let result = MdInline.parse("")
      assert (is_nil(result))
    end

    test "inline code with backtick" do
      let result = MdInline.parse("before `code` after")
      assert (match result do
              Cons(Inline.Text(before), Cons(Code(c), Cons(Inline.Text(after), Nil))) ->
                before == "before " && c == "code" && after == " after"
              _ -> false
              end)
    end

    test "unclosed backtick treated as literal text" do
      let result = MdInline.parse("no `close here")
      let ok = match result do
        Cons(Inline.Text(s), Nil) -> s == "no `close here"
        _ -> false
      end
      assert ok
    end

    test "empty code span produces Code with empty string" do
      let result = MdInline.parse("``")
      assert (match result do
              Cons(Code(c), Nil) -> String.is_empty(c)
              _ -> false
              end)
    end

    test "two code spans" do
      let result = MdInline.parse("`a` and `b`")
      let ok = match result do
        Cons(Code(a), Cons(Inline.Text(sep), Cons(Code(b), Nil))) -> a == "a" && sep == " and " && b == "b"
        _ -> false
      end
      assert ok
    end

    test "single-star emphasis" do
      let result = MdInline.parse("*hello*")
      assert (match result do
              Cons(Emph(inner), Nil) ->
                match inner do
                Cons(Inline.Text(t), Nil) -> t == "hello"
                _ -> false
                end
              _ -> false
              end)
    end

    test "double-star strong" do
      let result = MdInline.parse("**hello**")
      assert (match result do
              Cons(Strong(inner), Nil) ->
                match inner do
                Cons(Inline.Text(t), Nil) -> t == "hello"
                _ -> false
                end
              _ -> false
              end)
    end

    test "emphasis with surrounding text" do
      let result = MdInline.parse("a *b* c")
      assert (match result do
              Cons(Inline.Text(before), Cons(Emph(inner), Cons(Inline.Text(after), Nil))) ->
                before == "a " &&
                (match inner do Cons(Inline.Text(t), Nil) -> t == "b" | _ -> false end) &&
                after == " c"
              _ -> false
              end)
    end

    test "unclosed star treated as literal text" do
      let result = MdInline.parse("*no close")
      assert (match result do
              Cons(Inline.Text(t), Nil) -> t == "*no close"
              _ -> false
              end)
    end

    test "double-star takes precedence over single-star" do
      let result = MdInline.parse("**bold**")
      assert (match result do
              Cons(Strong(_), Nil) -> true
              _ -> false
              end)
    end

    test "unclosed double-star with preceding text preserved" do
      let result = MdInline.parse("hello **no close")
      assert (match result do
              Cons(Inline.Text(t), Nil) -> t == "hello **no close"
              _ -> false
              end)
    end
  end

  describe "MdBlock.parse" do
    test "empty string returns empty list" do
      -- Check emptiness by pattern match, not `==`: Block is recursive
      -- (BulletList(List(List(Block)))), so List(Block) has no derivable Eq.
      let is_empty =
        match MdBlock.parse("") do
        Nil -> true
        Cons(_, _) -> false
        end
      assert is_empty
    end

    test "single paragraph" do
      let result = MdBlock.parse("Hello world")
      assert (match result do
              Cons(Para(_), Nil) -> true
              _ -> false
              end)
    end

    test "multi-line paragraph joins lines with a space, not a raw newline" do
      let html = IOList.to_string(MdRender.render(MdBlock.parse("line one\nline two")))
      assert (String.contains(html, "line one line two"))
      assert (not (String.contains(html, "line one\nline two")))
    end

    test "h1 heading" do
      let result = MdBlock.parse("# Hello")
      assert (match result do
              Cons(Heading(1, _, _), Nil) -> true
              _ -> false
              end)
    end

    test "h2 heading" do
      let result = MdBlock.parse("## Section")
      assert (match result do
              Cons(Heading(2, _, _), Nil) -> true
              _ -> false
              end)
    end

    test "heading anchor is lowercased and hyphenated" do
      let result = MdBlock.parse("# Hello World")
      assert (match result do
              Cons(Heading(_, id, _), Nil) -> id == "hello-world"
              _ -> false
              end)
    end

    test "thematic break from three dashes" do
      let result = MdBlock.parse("---")
      assert (match result do
              Cons(ThematicBreak, Nil) -> true
              _ -> false
              end)
    end

    test "thematic break from three stars" do
      let result = MdBlock.parse("***")
      assert (match result do
              Cons(ThematicBreak, Nil) -> true
              _ -> false
              end)
    end

    test "two paragraphs separated by blank line" do
      let result = MdBlock.parse("First\n\nSecond")
      assert (List.length(result) == 2)
    end

    test "heading followed by paragraph" do
      let result = MdBlock.parse("# Title\n\nBody text")
      assert (match result do
              Cons(Heading(1, _, _), Cons(Para(_), Nil)) -> true
              _ -> false
              end)
    end

    test "thematic break from three underscores" do
      let result = MdBlock.parse("___")
      assert (match result do
              Cons(ThematicBreak, Nil) -> true
              _ -> false
              end)
    end

    test "paragraph followed immediately by heading (no blank line)" do
      let result = MdBlock.parse("Some text\n# Heading")
      assert (match result do
              Cons(Para(_), Cons(Heading(1, _, _), Nil)) -> true
              _ -> false
              end)
    end

    test "fenced code block with language" do
      let md = "```march\nfn f(x) do x end\n```"
      let result = MdBlock.parse(md)
      assert (match result do
              Cons(CodeBlock(lang, body), Nil) ->
                lang == "march" && String.contains(body, "fn f(x)")
              _ -> false
              end)
    end

    test "fenced code block no language" do
      let md = "```\nhello\n```"
      let result = MdBlock.parse(md)
      assert (match result do
              Cons(CodeBlock(lang, _), Nil) -> String.is_empty(lang)
              _ -> false
              end)
    end

    test "tilde fence" do
      let md = "~~~\ncode here\n~~~"
      let result = MdBlock.parse(md)
      assert (match result do
              Cons(CodeBlock(_, _), Nil) -> true
              _ -> false
              end)
    end

    test "code block followed by paragraph" do
      let md = "```\ncode\n```\n\nPara"
      let result = MdBlock.parse(md)
      assert (match result do
              Cons(CodeBlock(_, _), Cons(Para(_), Nil)) -> true
              _ -> false
              end)
    end

    test "blockquote single line" do
      let result = MdBlock.parse("> hello")
      assert (match result do
              Cons(Quote(_), Nil) -> true
              _ -> false
              end)
    end

    test "blockquote strips > prefix and parses inner content" do
      let result = MdBlock.parse("> inner text")
      let inner_html = match result do
                       Cons(Quote(inner), Nil) -> IOList.to_string(MdRender.render(inner))
                       _ -> ""
                       end
      assert (String.contains(inner_html, "inner text"))
    end

    test "bullet list with dash" do
      let result = MdBlock.parse("- alpha\n- beta\n- gamma")
      assert (match result do
              Cons(BulletList(items), Nil) -> List.length(items) == 3
              _ -> false
              end)
    end

    test "bullet list with star" do
      let result = MdBlock.parse("* one\n* two")
      assert (match result do
              Cons(BulletList(items), Nil) -> List.length(items) == 2
              _ -> false
              end)
    end
  end

end
