-- Blog-style collection outputs generated from the site index: tag index pages,
-- sitemap.xml, the RSS feed, and the chronological home archive.  Extracted from
-- Build so the render pipeline and the collections subsystem live in separate
-- modules.  Build.run_core calls Collections.build_collections in blog mode;
-- docs mode (Build.run_pages) skips it.
mod Collections do

  needs IO.FileWrite

  pfn fmt_err(e) : String do
    to_string(e)
  end

  -- Convert a tag name to a URL-safe slug: lowercase, spaces → hyphens.
  pfn tag_slug(tag : String) : String do
    String.replace_all(String.to_lowercase(tag), " ", "-")
  end

  -- ─── Pass 2b: generate collections ──────────────────────────────────────────
  -- Build all collection outputs: tag index pages, sitemap.xml, feed.xml.
  --
  -- RC note: sorted is consumed by tags_of_entries, build_tag_pages, write_sitemap,
  -- write_feed, and write_index.  The previous closure-based approach (run_collections capturing
  -- sorted) made sorted a _borrowed_field_var inside the closure, which suppresses
  -- Perceus IncRC for nested closure captures — recurse_sitemap and recurse_tag
  -- each captured sorted without IncRC, causing use-after-free when the first
  -- caller freed it.
  --
  -- Fix: no closures.  build_tag_dir is called first (before sorted is computed)
  -- so an early-exit Err path never touches sorted at all.  On the Ok path, sorted
  -- is a plain let-binding and the four consuming callers are at the same sequential
  -- scope level inside the Ok arm, so Perceus correctly inserts IncRCs for each
  -- non-last use.  output_dir and base_url are borrowed throughout (Path.join
  -- borrows both args), so no IncRC is needed for them either.
  fn build_collections(output_dir : String, site_title : String, base_url : String, idx, opt_idx_fn) : Result(Unit, String) do
    match build_tag_dir(output_dir) do
    Err(e) -> Err(e)
    Ok(_) -> do
      -- Derive the subpath link prefix once; base_url is borrowed (link_prefix
      -- only concatenates), so it stays live for write_sitemap/write_feed below.
      let prefix = PathUtil.link_prefix(base_url)
      let sorted = SiteIndex.sorted_by_date(idx)
      -- RC note: entry_tags returns the entry's tags list BORROWED (the entry
      -- owns it; there is no userland way to deep-copy a borrowed list).  So
      -- the tags lists must be read exactly ONCE.  Do a single pass that copies
      -- each (tag, slug, title) into owned triples; all later tag work (unique
      -- tag names, per-tag filtering) uses only the triples.  sitemap/feed read
      -- only the entries' string fields, whose accessors return fresh copies.
      let triples = List.flat_map(sorted, fn e -> do
        let slug  = SiteIndex.entry_slug(e)
        let title = SiteIndex.entry_title(e)
        List.map(SiteIndex.entry_tags(e), fn t -> ("${t}", slug, title))
      end)
      let tags = SiteIndex.unique_strs(List.map(triples, fn tr -> match tr do (t, _, _) -> t end))
      match build_tag_pages(output_dir, prefix, tags, triples) do
      Err(e) -> Err(e)
      Ok(_) -> do
        match write_sitemap(output_dir, base_url, sorted) do
        Err(e) -> Err(e)
        Ok(_) -> do
          match write_feed(output_dir, site_title, base_url, sorted) do
          Err(e) -> Err(e)
          Ok(_) -> write_index(output_dir, prefix, site_title, sorted, opt_idx_fn)
          end
        end
        end
      end
      end
    end
    end
  end

  -- ─── Tag index pages ─────────────────────────────────────────────────────────
  pfn build_tag_dir(output_dir : String) : Result(Unit, String) do
    let tag_dir = Path.join(output_dir, "tag")
    match Dir.mkdir_p(tag_dir) do
    Err(e) -> Err("cannot create tag dir: " ++ fmt_err(e))
    Ok(_) -> Ok(())
    end
  end

  -- tags: distinct tag names; triples: owned (tag, slug, title) rows built by
  -- the single tag pass in build_collections.
  -- prefix: root-relative URL prefix (e.g. "/march"), borrowed throughout exactly
  -- like output_dir — only ever concatenated into hrefs.
  pfn build_tag_pages(output_dir : String, prefix : String, tags : List(String), triples) : Result(Unit, String) do
    match tags do
    Nil -> Ok(())
    Cons(tag, rest_tags) -> do
      let slug = tag_slug(tag)
      -- RC note: triples is consumed by List.filter AND by the recursive call.
      -- Capture the recursive continuation BEFORE the consuming List.filter call
      -- so both uses of triples are visible to Perceus at the same scope level.
      let recurse = fn _ -> build_tag_pages(output_dir, prefix, rest_tags, triples)
      let tagged =
        List.filter(triples, fn tr -> match tr do (t, _, _) -> t == tag end)
      match write_tag_page(output_dir, prefix, tag, slug, tagged) do
      Err(e) -> Err(e)
      Ok(_) -> recurse(())
      end
    end
    end
  end

  pfn write_tag_page(output_dir : String, prefix : String, tag : String, slug : String, triples) : Result(Unit, String) do
    let title = "Posts tagged: " ++ tag
    let items = tag_page_items(prefix, triples)
    let body_html =
      IOList.from_string("<h1>")
        |> IOList.append(IOList.from_string(Html.escape(title)))
        |> IOList.append(IOList.from_string("</h1><ul>"))
        |> IOList.append(items)
        |> IOList.append(IOList.from_string("</ul>"))
    let page_html = Html.layout(title, IOList.empty(), body_html)
    let path = Path.join(Path.join(output_dir, "tag"), slug ++ ".html")
    match File.write(path, IOList.to_string(page_html)) do
    Err(e) -> Err("cannot write tag page " ++ path ++ ": " ++ fmt_err(e))
    Ok(_) -> Ok(())
    end
  end

  pfn tag_page_items(prefix : String, triples) : IOList do
    -- Each triple is an owned (tag, slug, title) row built by build_collections;
    -- the strings are independent copies, so destructuring here is RC-safe.
    Html.list(triples, fn tr -> do
      match tr do
      (_, slug, title) ->
        IOList.from_string("<li><a href=\"" ++ prefix ++ "/" ++ slug ++ ".html\">" ++ Html.escape(title) ++ "</a></li>")
      end
    end)
  end

  -- ─── Sitemap ─────────────────────────────────────────────────────────────────
  pfn write_sitemap(output_dir : String, base_url : String, entries) : Result(Unit, String) do
    let xml = sitemap_xml(base_url, entries)
    let path = Path.join(output_dir, "sitemap.xml")
    match File.write(path, xml) do
    Err(e) -> Err("cannot write sitemap: " ++ fmt_err(e))
    Ok(_) -> Ok(())
    end
  end

  pfn sitemap_xml(base_url : String, entries) : String do
    -- Normalise a trailing "/" so loc = base ++ "/" ++ slug never doubles it.
    let prefix = PathUtil.strip_trailing_slash(base_url)
    let items = IOList.to_string(sitemap_items(prefix, entries))
    """<?xml version="1.0" encoding="UTF-8"?>
""" ++ """<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
""" ++ items ++ "</urlset>\n"
  end

  -- Build the <url> entries as an IOList (O(n) append) rather than quadratic
  -- String concatenation.  Each accessor borrows e and returns a fresh String.
  pfn sitemap_items(base_url : String, entries) : IOList do
    Html.list(entries, fn e -> do
      let slug = SiteIndex.entry_slug(e)
      let date = SiteIndex.entry_date(e)
      let loc = base_url ++ "/" ++ slug ++ ".html"
      let lastmod =
        if String.is_empty(date) do
          ""
        else
          "  <lastmod>" ++ date ++ """</lastmod>
"""
        end
      IOList.from_string("""  <url>
  <loc>""" ++ loc ++ "</loc>\n" ++ lastmod ++ "  </url>\n")
    end)
  end

  -- ─── RSS feed ────────────────────────────────────────────────────────────────
  pfn write_feed(output_dir : String, site_title : String, base_url : String, entries) : Result(Unit, String) do
    let xml = feed_xml(site_title, base_url, entries)
    let path = Path.join(output_dir, "feed.xml")
    match File.write(path, xml) do
    Err(e) -> Err("cannot write feed: " ++ fmt_err(e))
    Ok(_) -> Ok(())
    end
  end

  pfn feed_xml(site_title : String, base_url : String, entries) : String do
    -- Normalise a trailing "/" once into a fresh owned `base` (strip_trailing_slash
    -- returns a new String, not a borrow-alias of base_url), then read it twice —
    -- in feed_items and the channel <link>.
    let base     = PathUtil.strip_trailing_slash(base_url)
    let ch_title = if String.is_empty(site_title) do "My Site" else site_title end
    let ch_desc  = "Recent posts from " ++ ch_title
    let items = IOList.to_string(feed_items(base, entries))
    """<?xml version="1.0" encoding="UTF-8"?>
""" ++ """<rss version="2.0">
""" ++ "<channel>\n" ++ "  <title>" ++ Html.escape(ch_title) ++ "</title>\n" ++ "  <link>" ++ Html.escape(base) ++ "</link>\n" ++ "  <description>" ++ Html.escape(ch_desc) ++ "</description>\n" ++ items ++ """</channel>
""" ++ "</rss>\n"
  end

  -- Build the <item> entries as an IOList (O(n)) rather than quadratic concat.
  pfn feed_items(base_url : String, entries) : IOList do
    Html.list(entries, fn e -> do
      let slug = SiteIndex.entry_slug(e)
      let title = SiteIndex.entry_title(e)
      let date = SiteIndex.entry_date(e)
      let excerpt = SiteIndex.entry_excerpt(e)
      let link = base_url ++ "/" ++ slug ++ ".html"
      let pubdate =
        if String.is_empty(date) do
          ""
        else
          "    <pubDate>" ++ date ++ """</pubDate>
"""
        end
      let description =
        if String.is_empty(excerpt) do
          ""
        else
          "    <description><![CDATA[" ++ excerpt ++ """]]></description>
"""
        end
      IOList.from_string(
        "  <item>\n" ++ "    <title>" ++ Html.escape(title) ++ "</title>\n" ++ "    <link>" ++ Html.escape(link) ++ "</link>\n" ++ pubdate ++ description ++ "  </item>\n")
    end)
  end

  -- ─── Home index page ─────────────────────────────────────────────────────────
  -- Write out/index.html.  When opt_idx_fn is Some(f), calls f(entries) to get a
  -- complete HTML document IOList (the caller is responsible for <html>, <head>,
  -- etc.).  When None, falls back to the default bare-bones archive listing.
  -- `entries` is the date-sorted index from build_collections.
  pfn write_index(output_dir : String, prefix : String, site_title : String, entries, opt_idx_fn) : Result(Unit, String) do
    let page_html = match opt_idx_fn do
      Some(idx_fn) -> SiteIndex.apply_index_fn(idx_fn, entries)
      None -> do
        let heading = if String.is_empty(site_title) do "Home" else site_title end
        let body_html =
          IOList.from_string("<h1>" ++ Html.escape(heading) ++ "</h1><ul>")
            |> IOList.append(index_items(prefix, entries))
            |> IOList.append(IOList.from_string("</ul>"))
        Html.layout(heading, IOList.empty(), body_html)
      end
    end
    let path = Path.join(output_dir, "index.html")
    match File.write(path, IOList.to_string(page_html)) do
    Err(e) -> Err("cannot write index: " ++ fmt_err(e))
    Ok(_) -> Ok(())
    end
  end

  -- Render the index list items as an HTML string.  Mirrors feed_items: each
  -- entry's slug/title/date accessor borrows the entry and returns a fresh
  -- String, so a single forward pass with tail-style recursion is RC-safe.
  pfn index_items(prefix : String, entries) : IOList do
    Html.list(entries, fn e -> do
      let slug  = SiteIndex.entry_slug(e)
      let title = SiteIndex.entry_title(e)
      let date  = SiteIndex.entry_date(e)
      let date_html =
        if String.is_empty(date) do "" else " <time>" ++ Html.escape(date) ++ "</time>" end
      IOList.from_string(
        "<li><a href=\"" ++ prefix ++ "/" ++ slug ++ ".html\">" ++ Html.escape(title) ++ "</a>" ++ date_html ++ "</li>")
    end)
  end

end
