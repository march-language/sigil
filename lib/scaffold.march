mod Scaffold do

  needs IO.FileRead
  needs IO.FileWrite

  pfn fmt_err(e) : String do
    to_string(e)
  end

  -- Sample markdown post with valid front-matter.
  pfn hello_world_md() : String do
    "---\n"
    ++ "title: Hello World\n"
    ++ "date: 2026-06-19\n"
    ++ "layout: post\n"
    ++ "tags: [hello, sigil]\n"
    ++ "draft: false\n"
    ++ "---\n"
    ++ "\n"
    ++ "# Hello, world!\n"
    ++ "\n"
    ++ "Welcome to your new Sigil site.\n"
    ++ "\n"
    ++ "- Edit posts in `content/posts/`\n"
    ++ "- Add pages (about, etc.) in `content/`\n"
    ++ "- Run `sigil build` to regenerate the site\n"
    ++ "- Run `sigil new post \"My Title\"` to scaffold a new post\n"
  end

  -- A minimal sample stylesheet.
  pfn style_css() : String do
    "body {\n"
    ++ "  font-family: system-ui, -apple-system, sans-serif;\n"
    ++ "  max-width: 40rem;\n"
    ++ "  margin: 2rem auto;\n"
    ++ "  padding: 0 1rem;\n"
    ++ "  line-height: 1.6;\n"
    ++ "  color: #222;\n"
    ++ "}\n"
    ++ "\n"
    ++ "a {\n"
    ++ "  color: #06c;\n"
    ++ "}\n"
    ++ "\n"
    ++ "code {\n"
    ++ "  background: #f4f4f4;\n"
    ++ "  padding: 0.1rem 0.3rem;\n"
    ++ "  border-radius: 3px;\n"
    ++ "}\n"
  end

  -- A starter config file. (Reading of sigil.toml lives on another branch;
  -- here we only need to write a sensible starter.)
  pfn sigil_toml() : String do
    "[site]\n"
    ++ "title = \"My Site\"\n"
    ++ "base_url = \"\"\n"
    ++ "\n"
    ++ "[build]\n"
    ++ "content_dir = \"content\"\n"
    ++ "output_dir = \"out\"\n"
    ++ "static_dir = \"static\"\n"
  end

  pfn readme_md() : String do
    "# My Sigil Site\n"
    ++ "\n"
    ++ "A starter site scaffolded by `sigil new`.\n"
    ++ "\n"
    ++ "## Quick start\n"
    ++ "\n"
    ++ "Build the site:\n"
    ++ "\n"
    ++ "    sigil build --content-dir content --output-dir out --static-dir static\n"
    ++ "\n"
    ++ "Then open `out/hello-world.html` in your browser.\n"
    ++ "\n"
    ++ "## Layout\n"
    ++ "\n"
    ++ "- `content/` — your markdown posts\n"
    ++ "- `static/`  — assets copied verbatim to the output\n"
    ++ "- `sigil.toml` — site configuration\n"
  end

  -- Write a single file, mapping any I/O error to a friendly message.
  pfn write_file(path : String, contents : String) : Result(Unit, String) do
    match File.write(path, contents) do
    Err(e) -> Err("cannot write " ++ path ++ ": " ++ fmt_err(e))
    Ok(_)  -> Ok(())
    end
  end

  -- Create a directory (with parents), mapping errors to a friendly message.
  pfn make_dir(path : String) : Result(Unit, String) do
    match Dir.mkdir_p(path) do
    Err(e) -> Err("cannot create directory " ++ path ++ ": " ++ fmt_err(e))
    Ok(_)  -> Ok(())
    end
  end

  -- Scaffold a starter site into `dir`.
  -- Refuses if `dir` already exists (safest: avoids clobbering user files).
  -- On success returns Ok(()); the caller prints next-step instructions.
  fn create(dir : String) : Result(Unit, String) do
    if Dir.exists(dir) do
      Err("target directory already exists: " ++ dir ++ " (refusing to overwrite)")
    else
      -- Keep an independent copy of `dir` so a partial failure mid-scaffold can be
      -- rolled back.  Without this, a half-created tree would block re-running
      -- (create refuses when the dir already exists), stranding the user.
      let dir_clean = "" ++ dir
      match create_files(dir) do
      Ok(_)  -> Ok(())
      Err(m) -> do
        let _ = Dir.rm_rf(dir_clean)
        Err(m)
      end
      end
    end
  end

  pfn create_files(dir : String) : Result(Unit, String) do
    let content_dir = Path.join(dir, "content")
    let static_dir  = Path.join(dir, "static")
    match make_dir(dir) do
    Err(m) -> Err(m)
    Ok(_) ->
      match make_dir(content_dir) do
      Err(m) -> Err(m)
      Ok(_) ->
        match make_dir(static_dir) do
        Err(m) -> Err(m)
        Ok(_) ->
          write_payload(dir, content_dir, static_dir)
        end
      end
    end
  end

  pfn write_payload(dir : String, content_dir : String, static_dir : String) : Result(Unit, String) do
    let posts_dir = Path.join(content_dir, "posts")
    match make_dir(posts_dir) do
    Err(m) -> Err(m)
    Ok(_) ->
    match write_file(Path.join(posts_dir, "hello-world.md"), hello_world_md()) do
    Err(m) -> Err(m)
    Ok(_) ->
      match write_file(Path.join(static_dir, "style.css"), style_css()) do
      Err(m) -> Err(m)
      Ok(_) ->
        match write_file(Path.join(dir, "sigil.toml"), sigil_toml()) do
        Err(m) -> Err(m)
        Ok(_) ->
          write_file(Path.join(dir, "README.md"), readme_md())
        end
      end
    end
    end
  end

  -- Friendly next-step message printed after a successful scaffold.
  fn next_steps(dir : String) : String do
    "Created a new Sigil site in " ++ dir ++ "\n"
    ++ "\n"
    ++ "Next steps:\n"
    ++ "  cd " ++ dir ++ "\n"
    ++ "  sigil build\n"
    ++ "  sigil new post \"My First Post\"\n"
  end

  -- ─── New post scaffolding ────────────────────────────────────────────────────

  -- Scaffold a new post file at content/posts/DATE-SLUG.md.
  -- `date_str` is YYYY-MM-DD (supplied by the caller from DateTime.now()).
  -- Returns Ok(filepath) on success so the caller can print a confirmation.
  fn create_post(title : String, date_str : String) : Result(String, String) do
    let slug     = title_to_slug(title)
    let filename = date_str ++ "-" ++ slug ++ ".md"
    let posts_dir = "content/posts"
    let filepath  = Path.join(posts_dir, filename)
    match make_dir(posts_dir) do
    Err(m) -> Err(m)
    Ok(_)  ->
      if File.exists(filepath) do
        Err("file already exists: " ++ filepath)
      else
        let title_copy = "" ++ title
        let date_copy  = "" ++ date_str
        match write_file(filepath, new_post_md(title_copy, date_copy)) do
        Err(m) -> Err(m)
        Ok(_)  -> Ok(filepath)
        end
      end
    end
  end

  pfn new_post_md(title : String, date : String) : String do
    "---\n"
    ++ "title: " ++ title ++ "\n"
    ++ "date: " ++ date ++ "\n"
    ++ "layout: post\n"
    ++ "tags: []\n"
    ++ "draft: true\n"
    ++ "---\n"
    ++ "\n"
  end

  -- Convert a title string to a URL-safe slug: lowercase, spaces → hyphens.
  pfn title_to_slug(title : String) : String do
    String.replace_all(String.to_lowercase(title), " ", "-")
  end

end
