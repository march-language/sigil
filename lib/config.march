mod Config do

  type Site = {
    content_dir : String,
    output_dir  : String,
    static_dir  : String,
    title       : String,
    base_url    : String
  }

  fn default() : Site do
    { content_dir: "content", output_dir: "out", static_dir: "static",
      title: "My Site", base_url: "" }
  end

  -- Accessors — avoid direct record field access across modules (Perceus RC safety).
  -- These return the field directly (a borrow-return), which compiles and runs
  -- correctly on the current compiler.  If a call site ever hits the Perceus
  -- elision bug that drops the IncRC on a returned record field, wrap the result
  -- in `"" ++` to force a fresh owned allocation (see SiteIndex.entry_excerpt).
  fn site_title(s : Site) : String do s.title end
  fn site_base_url(s : Site) : String do s.base_url end
  fn site_content_dir(s : Site) : String do s.content_dir end
  fn site_output_dir(s : Site) : String do s.output_dir end
  fn site_static_dir(s : Site) : String do s.static_dir end

end
