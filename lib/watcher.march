mod Watcher do

  -- Read the output directory from the process environment.
  -- The Serve module sets SIGIL_OUTPUT_DIR before starting the watcher.
  -- Using System.env() on each call gives a fresh String with its own RC,
  -- avoiding Perceus RC underflow issues in TCO loops that would occur if
  -- output_dir were passed as a loop parameter and used multiple times per iteration.
  pfn get_output_dir() : String do
    match System.env("SIGIL_OUTPUT_DIR") do
    Some(d) -> d
    None    -> "out"
    end
  end

  -- Read the content directory from the process environment.
  -- Serve.prun sets SIGIL_CONTENT_DIR before spawning the watcher task so that
  -- watch_env() can be called as a zero-capture lambda (no closure fields).
  fn get_content_dir() : String do
    match System.env("SIGIL_CONTENT_DIR") do
    Some(d) -> d
    None    -> "content"
    end
  end

  fn version_path(output_dir : String) : String do
    Path.join(output_dir, ".sigil-reload")
  end

  fn read_version(output_dir : String) : Int do
    match File.read(version_path(output_dir)) do
    Err(_) -> 0
    Ok(s)  ->
      match string_to_int(String.trim(s)) do
      Some(n) -> n
      None    -> 0
      end
    end
  end

  fn write_version(output_dir : String, n : Int) : Result(Unit, String) do
    let path = version_path(output_dir)
    let data = int_to_string(n)
    match File.write(path, data) do
    Err(e) -> Err(to_string(e))
    Ok(_)  -> Ok(())
    end
  end

  pfn mtime_acc(acc : Int, path : String) : Int do
    match File.mtime(path) do
    Err(_) -> acc
    Ok(m)  -> if m > acc do m else acc end
    end
  end

  fn max_mtime(dir : String) : Int do
    -- Recurses into subdirectories via Build.collect_md, matching Build.run so
    -- that edits to nested content files (content/posts/*.md) trigger a rebuild.
    let md_paths = Build.collect_md(dir)
    List.fold_left(md_paths, 0, fn (acc, path) -> mtime_acc(acc, path))
  end

  -- Watch for changes in content_dir. output_dir and static_dir are read from
  -- the process environment (SIGIL_OUTPUT_DIR, SIGIL_STATIC_DIR) on each poll
  -- iteration to avoid Perceus RC underflow: the Perceus pass does not correctly
  -- insert incrc for function-parameter strings used in both a function call
  -- (write_version) and a TCO back-edge in the same branch.
  fn watch(content_dir : String) : Unit do
    watch_loop(content_dir, 0, 0)
  end

  -- Zero-capture entry point for task_spawn.  Reads content_dir from the
  -- SIGIL_CONTENT_DIR process environment variable set by Serve.prun, so the
  -- spawned lambda captures no heap values and the march task scheduler does not
  -- need to RC-manage any closure fields.
  --   task_spawn(fn _ -> Watcher.watch_env())
  fn watch_env() : Unit do
    watch(get_content_dir())
  end

  pfn watch_loop(content_dir : String, last_mtime : Int, version : Int) : Unit do
    -- Note: max_mtime and Build.run both recurse into subdirectories (Build.collect_md).
    let _ = System.cmd("sleep", Cons("0.3", Nil))
    let current = max_mtime(content_dir)
    if current > last_mtime do
      let output_dir = get_output_dir()
      let static_dir = match System.env("SIGIL_STATIC_DIR") do Some(d) -> d | None -> "static" end
      let site = { content_dir = content_dir, output_dir = output_dir, static_dir = static_dir,
                   title = "", base_url = "" }
      match Build.run(site) do
      Err(msg) ->
        println("[sigil] build error: " ++ msg)
        -- Don't advance last_mtime so we retry on next change
        watch_loop(content_dir, last_mtime, version)
      Ok(_) ->
        let next = version + 1
        let od2 = get_output_dir()
        let _ = write_version(od2, next)
        println("[sigil] rebuilt (v" ++ int_to_string(next) ++ ")")
        watch_loop(content_dir, current, next)
      end
    else
      watch_loop(content_dir, last_mtime, version)
    end
  end

end
