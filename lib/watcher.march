mod Watcher do

  needs IO.Console

  -- Read the output directory from the process environment.
  -- The Serve module sets SIGIL_OUTPUT_DIR before starting the watcher.
  -- Using System.env() on each call gives a fresh String with its own RC,
  -- avoiding Perceus RC underflow issues in TCO loops that would occur if
  -- output_dir were passed as a loop parameter and used multiple times per iteration.
  pfn get_output_dir() : String do
    match System.env("SIGIL_OUTPUT_DIR") do
    Some(d) -> d
    None    -> "out"
    end
  end

  -- Read the content directory from the process environment.
  -- Serve.prun sets SIGIL_CONTENT_DIR before spawning the watcher task so that
  -- watch_env() can be called as a zero-capture lambda (no closure fields).
  fn get_content_dir() : String do
    match System.env("SIGIL_CONTENT_DIR") do
    Some(d) -> d
    None    -> "content"
    end
  end

  fn version_path(output_dir : String) : String do
    Path.join(output_dir, ".sigil-reload")
  end

  fn read_version(output_dir : String) : Int do
    match File.read(version_path(output_dir)) do
    Err(_) -> 0
    Ok(s)  ->
      match string_to_int(String.trim(s)) do
      Some(n) -> n
      None    -> 0
      end
    end
  end

  fn write_version(output_dir : String, n : Int) : Result(Unit, String) do
    let path = version_path(output_dir)
    let data = int_to_string(n)
    match File.write(path, data) do
    Err(e) -> Err(to_string(e))
    Ok(_)  -> Ok(())
    end
  end

  pfn mtime_acc(acc : Int, path : String) : Int do
    match File.mtime(path) do
    Err(_) -> acc
    Ok(m)  -> if m > acc do m else acc end
    end
  end

  fn max_mtime(dir : String) : Int do
    -- Recurses into subdirectories via Build.collect_md, matching Build.run so
    -- that edits to nested content files (content/posts/*.md) trigger a rebuild.
    let md_paths = Build.collect_md(dir)
    List.fold_left(md_paths, 0, fn (acc, path) -> mtime_acc(acc, path))
  end

  -- Max mtime over EVERY file under `dir` (recursively), not just .md — used to
  -- watch the static asset tree (CSS/JS/images) so edits there trigger a rebuild.
  -- Mirrors Build.collect_md_walk's tail-recursive worklist discipline.
  fn max_mtime_tree(dir : String) : Int do
    match Dir.list_full(dir) do
    Err(_)      -> 0
    Ok(entries) -> mtime_walk(entries, 0)
    end
  end

  pfn mtime_walk(work : List(String), acc : Int) : Int do
    match work do
    Nil -> acc
    Cons(p, rest) -> do
      if Dir.exists(p) do
        let sub = match Dir.list_full(p) do Ok(es) -> es | Err(_) -> Nil end
        mtime_walk(List.append(sub, rest), acc)
      else
        mtime_walk(rest, mtime_acc(acc, p))
      end
    end
    end
  end

  -- Count every file under `dir` (recursively).  Combined with max mtime, a
  -- changing count lets the watcher notice DELETIONS (which lower the max mtime
  -- and would otherwise never trigger a rebuild).
  fn count_tree(dir : String) : Int do
    match Dir.list_full(dir) do
    Err(_)      -> 0
    Ok(entries) -> count_walk(entries, 0)
    end
  end

  pfn count_walk(work : List(String), acc : Int) : Int do
    match work do
    Nil -> acc
    Cons(p, rest) -> do
      if Dir.exists(p) do
        let sub = match Dir.list_full(p) do Ok(es) -> es | Err(_) -> Nil end
        count_walk(List.append(sub, rest), acc)
      else
        count_walk(rest, acc + 1)
      end
    end
    end
  end

  -- Run `forge build` in the current working directory.
  -- Returns Ok(()) when the build exits 0, Err(msg) otherwise.
  pfn rebuild_binary() : Result(Unit, String) do
    let _ = println("[sigil] rebuilding binary with forge build...")
    match Process.run("forge", Cons("build", Nil)) do
    Err(e) -> Err("forge build failed to spawn: " ++ e)
    Ok(r)  -> do
      -- Extract all three fields before any conditional so Perceus sees all
      -- uses of `r` at the same sequential scope level.
      let ok  = Process.ok(r)
      let out = Process.stdout(r)
      let err = Process.stderr(r)
      let _   = if String.is_empty(out) do () else println(out) end
      if ok do
        Ok(())
      else
        let _   = if String.is_empty(err) do () else println(err) end
        Err("forge build exited non-zero")
      end
    end
    end
  end

  -- Snapshot the current lib mtime so the first watch_loop iteration does not
  -- false-positive a rebuild (lib_mtime would otherwise beat last_lib_mtime=0).
  pfn initial_lib_mtime() : Int do
    match System.env("SIGIL_LIB_DIR") do
    Some(d) -> max_mtime_tree(d)
    None    -> 0
    end
  end

  -- Watch for changes in content_dir. output_dir and static_dir are read from
  -- the process environment (SIGIL_OUTPUT_DIR, SIGIL_STATIC_DIR) on each poll
  -- iteration to avoid Perceus RC underflow: the Perceus pass does not correctly
  -- insert incrc for function-parameter strings used in both a function call
  -- (write_version) and a TCO back-edge in the same branch.
  fn watch(content_dir : String) : Unit do
    watch_loop(content_dir, 0, 0, initial_lib_mtime(), 0)
  end

  -- Zero-capture entry point for task_spawn.  Reads content_dir from the
  -- SIGIL_CONTENT_DIR process environment variable set by Serve.prun, so the
  -- spawned lambda captures no heap values and the march task scheduler does not
  -- need to RC-manage any closure fields.
  --   task_spawn(fn _ -> Watcher.watch_env())
  fn watch_env() : Unit do
    watch(get_content_dir())
  end

  pfn watch_loop(content_dir : String, last_mtime : Int, last_count : Int, last_lib_mtime : Int, version : Int) : Unit do
    let _ = System.cmd("sleep", Cons("0.3", Nil))

    -- Poll content (.md files) and static asset tree for changes.
    let content_mtime = max_mtime(content_dir)
    let static_watch  = match System.env("SIGIL_STATIC_DIR") do Some(d) -> d | None -> "static" end
    let static_mtime  = max_mtime_tree(static_watch)
    let current = if content_mtime > static_mtime do content_mtime else static_mtime end
    let static_watch2 = match System.env("SIGIL_STATIC_DIR") do Some(d) -> d | None -> "static" end
    let count = count_tree(content_dir) + count_tree(static_watch2)

    -- Poll the lib source directory (SIGIL_LIB_DIR) for .march file changes.
    -- A change means the binary must be recompiled; we rebuild then exit so the
    -- user (or a watch loop) can restart the server with the new binary.
    let lib_mtime = match System.env("SIGIL_LIB_DIR") do
                    Some(d) -> max_mtime_tree(d)
                    None    -> 0
                    end
    let lib_changed     = lib_mtime > last_lib_mtime
    let content_changed = current > last_mtime || count != last_count

    if lib_changed do
      let _ = println("[sigil] layout source changed")
      match rebuild_binary() do
      Err(e) ->
        let _ = println("[sigil] build error: " ++ e)
        -- Advance last_lib_mtime so we don't re-trigger on the same mtime,
        -- but keep serving with the old binary until a clean build lands.
        watch_loop(content_dir, last_mtime, last_count, lib_mtime, version)
      Ok(_) ->
        let _ = println("[sigil] binary rebuilt — restarting server")
        -- Exit cleanly; the browser WebSocket reconnect script reloads the
        -- page once the user (or a restart loop) brings the server back up.
        Process.exit(0)
      end
    else
      if content_changed do
        let output_dir = get_output_dir()
        let static_dir = match System.env("SIGIL_STATIC_DIR") do Some(d) -> d | None -> "static" end
        let site = { content_dir: content_dir, output_dir: output_dir, static_dir: static_dir,
                     title: "", base_url: "" }
        match Build.run(site) do
        Err(msg) ->
          let _ = println("[sigil] build error: " ++ msg)
          watch_loop(content_dir, last_mtime, last_count, last_lib_mtime, version)
        Ok(_) ->
          let next = version + 1
          let od2 = get_output_dir()
          let _ = write_version(od2, next)
          let _ = println("[sigil] rebuilt (v" ++ int_to_string(next) ++ ")")
          watch_loop(content_dir, current, count, last_lib_mtime, next)
        end
      else
        watch_loop(content_dir, last_mtime, last_count, last_lib_mtime, version)
      end
    end
  end

end
