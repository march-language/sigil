mod Build do

  needs IO.Console

  -- Wrapper for a user-supplied layout function.
  -- Uses a nominal type to avoid March's curried function-type annotation ambiguity.
  -- Site-wide metadata is intentionally NOT part of the function type: the caller
  -- should capture any site info it needs in the closure at creation time (e.g. in
  -- main.march) so that a cross-module record never flows through the recursive
  -- build_all_layout loop, avoiding Perceus RC underflow.
  -- Usage: Build.LayoutFn(fn p -> fn c -> MyLayout.render(my_site_info, p, c))
  type LayoutFn = LayoutFn(Page.Meta -> IOList -> IOList)

  -- Wrapper for a layout *selector*: maps a layout name (Page.meta_layout) to a
  -- LayoutFn.  Nominal type for the same currying-ambiguity reason as LayoutFn.
  -- The selector is threaded through the render loop exactly like a LayoutFn was,
  -- so it must obey the same Perceus discipline (capture the recursive
  -- continuation BEFORE the selector is consumed on each iteration).
  type Selector = Selector(String -> LayoutFn)


  pfn fmt_err(e) : String do
    to_string(e)
  end

  -- A content file is Markdown (".md") or a Scroll notebook (".scrollmd"): a
  -- Scroll notebook is plain Markdown with fenced `march` code cells, so the
  -- same parser/renderer handles both (cells become highlightable code blocks).
  -- Path.extension uses a `Some(0)` literal pattern which crashes at runtime,
  -- so use String.ends_with until that stdlib bug is fixed.
  pfn is_content(path : String) : Bool do
    String.ends_with(path, ".md") || String.ends_with(path, ".scrollmd")
  end

  -- Recursively collect every `.md` file under `dir` (depth-first), returning
  -- full paths ready to open.  `Dir.exists` is true only for directories, so it
  -- distinguishes a subdirectory entry from a regular file.
  --
  -- NOTE: output mirrors the content tree (see rel_slug): content/posts/foo.md
  -- renders to out/posts/foo.html.  The content-root is threaded through the
  -- index and render passes so the slug is the source path relative to it.
  --
  -- LIMITATION: `Dir.exists` follows symlinks (stat, not lstat), so a directory
  -- symlink that points at an ancestor (content/loop -> content/) would recurse
  -- forever.  Do not place directory symlink cycles under the content dir.  A
  -- visited-set guard is deferred (it would thread another list through the walk,
  -- which the native RC path handles poorly).
  --
  -- RC note: this is a tail-recursive worklist walk over a single accumulator,
  -- mirroring the isolation-verified minimal walker; `p` is used at most twice
  -- per iteration (Dir.exists + Dir.list_full, or is_content + Cons), which Perceus
  -- handles reliably for a borrowed-then-consumed parameter.
  fn collect_md(dir : String) : List(String) do
    match Dir.list_full(dir) do
    Err(_) -> Nil
    Ok(entries) -> List.reverse(collect_md_walk(entries, Nil))
    end
  end

  pfn collect_md_walk(work : List(String), acc : List(String)) : List(String) do
    match work do
    Nil -> acc
    Cons(p, rest) -> do
      if Dir.exists(p) do
        let sub = match Dir.list_full(p) do Ok(es) -> es | Err(_) -> Nil end
        collect_md_walk(List.append(sub, rest), acc)
      else
        if is_content(p) do collect_md_walk(rest, Cons(p, acc))
        else collect_md_walk(rest, acc) end
      end
    end
    end
  end

  -- Strip a trailing content extension: ".scrollmd" (9 bytes) or ".md" (3 bytes).
  pfn drop_content_ext(s : String) : String do
    if String.ends_with(s, ".scrollmd") do
      String.slice_bytes(s, 0, String.byte_size(s) - 9)
    else if String.ends_with(s, ".md") do
      String.slice_bytes(s, 0, String.byte_size(s) - 3)
    else
      s
    end end
  end

  -- Compute a root-relative slug that mirrors the source tree, with the content
  -- extension (".md" / ".scrollmd") removed.
  --   rel_slug("content", "content/hello.md")        == "hello"
  --   rel_slug("content", "content/docs/intro.md")   == "docs/intro"
  --   rel_slug("content", "content/notebook.scrollmd") == "notebook"
  -- A path that does not live under content_root falls back to its basename
  -- (preserving the old flat behaviour for stray inputs).
  fn rel_slug(content_root : String, src : String) : String do
    drop_content_ext(PathUtil.rel_under(content_root, src))
  end

  -- Apply a layout. Explicit let-bindings keep intermediate closure liveness
  -- visible to Perceus, preventing RC underflow.
  -- Note: site info is NOT a parameter here — it must be captured in the
  -- LayoutFn closure by the caller.  See LayoutFn comment above.
  pfn apply_layout(lf : LayoutFn, page : Page.Meta, content : IOList) : IOList do
    match lf do
    LayoutFn(f) -> do
      let f1 = f(page)
      f1(content)
    end
    end
  end

  -- Default layout used by Build.run: delegates to Html.layout.
  pfn default_layout_fn() : LayoutFn do
    LayoutFn(fn page -> fn content -> Html.layout(Page.meta_title(page), IOList.empty(), content))
  end

  -- "post" layout: like the default wrapper, but prepends a <header> containing
  -- the page title as an <h1> and the date in a <time> element, giving posts a
  -- visibly different structure from plain "default" pages.
  pfn post_layout_fn() : LayoutFn do
    LayoutFn(fn page -> fn content -> do
      -- RC note: page borrows for meta_title/meta_date; the accessors return
      -- fresh owned Strings, so reading them sequentially here is RC-safe.  Bind
      -- a separate doc_title for the <title> element since `title` is consumed by
      -- the header concat below (bind-once / use-once house style).
      let title     = Page.meta_title(page)
      let doc_title = Page.meta_title(page)
      let date      = Page.meta_date(page)
      let date_html =
        if String.is_empty(date) do
          ""
        else
          "<time class=\"post-date\">" ++ Html.escape(date) ++ "</time>"
        end
      let header =
        IOList.from_string(
          "<header class=\"post-header\"><h1 class=\"post-title\">"
            ++ Html.escape(title)
            ++ "</h1>"
            ++ date_html
            ++ "</header>")
      let body =
        header
        |> IOList.append(IOList.from_string("<article class=\"post-body\">"))
        |> IOList.append(content)
        |> IOList.append(IOList.from_string("</article>"))
      Html.layout(doc_title, IOList.empty(), body)
    end)
  end

  -- Map a layout name to a concrete LayoutFn.  Unknown or empty names fall back
  -- to the default plain wrapper.
  pfn select_layout_fn(name : String) : LayoutFn do
    match name do
    "post" -> post_layout_fn()
    _      -> default_layout_fn()
    end
  end

  -- The selector used by Build.run: dispatches per page on its layout name.
  pfn default_selector() : Selector do
    Selector(fn name -> select_layout_fn(name))
  end

  -- A selector that ignores the page's layout name and always returns the given
  -- LayoutFn.  Used by run_with_layout to honour a caller-supplied override.
  -- RC note: lf is captured once in the closure; the selector is threaded
  -- through the render loop with the same IncRC-before-consume discipline as a
  -- bare LayoutFn, keeping the captured lf alive across iterations.
  pfn const_selector(lf : LayoutFn) : Selector do
    Selector(fn _ -> lf)
  end

  -- Resolve a Selector for a given layout name into a LayoutFn.
  pfn apply_selector(sel : Selector, name : String) : LayoutFn do
    match sel do
    Selector(g) -> g(name)
    end
  end

  -- ─── Two-pass build ─────────────────────────────────────────────────────────
  -- run_with_layout: two-pass build.
  --   Pass 1: scan content files, parse front-matter, build site index.
  --   Pass 2a: render each page to HTML using the supplied layout function.
  --   Pass 2b: generate collection pages (tag indexes, sitemap, RSS feed).
  -- site title and base_url for collections come from cfg.title / cfg.base_url.
  --
  -- RC safety: cfg is borrowed throughout (Config.site_* all take cfg:borrow),
  -- so we can call each accessor multiple times.  We derive a fresh owned String
  -- for every consuming callsite (Dir.mkdir_p, Dir.list_full, Assets.copy) so
  -- that each binding is used exactly once and Perceus never needs to emit a
  -- speculative IncRC across a match-arm boundary.
  fn run_with_layout(cfg : Config.Site, lf : LayoutFn) : Result(Unit, String) do
    run_with_selector(cfg, const_selector(lf))
  end

  -- Same two-pass build as run_with_layout, but the render pass dispatches the
  -- wrapper per page via a Selector (keyed on Page.meta_layout).  Generates the
  -- blog collections (home archive, tags, sitemap, RSS).
  fn run_with_selector(cfg : Config.Site, sel : Selector) : Result(Unit, String) do
    run_core(cfg, sel, true)
  end

  -- ─── Docs mode ───────────────────────────────────────────────────────────────
  -- Like run_with_selector but WITHOUT the blog collections.  Use this for a
  -- docs/landing site: the auto-generated out/index.html archive would otherwise
  -- clobber a hand-authored content/index.md, and RSS/tags/sitemap are blog-only.
  fn run_pages_with_selector(cfg : Config.Site, sel : Selector) : Result(Unit, String) do
    run_core(cfg, sel, false)
  end

  fn run_pages_with_layout(cfg : Config.Site, lf : LayoutFn) : Result(Unit, String) do
    run_pages_with_selector(cfg, const_selector(lf))
  end

  -- Like run_with_selector but fires Hook.Fn lists before and after the build.
  -- Existing callers of run_with_selector / run_with_layout are unaffected.
  fn run_with_selector_and_hooks(cfg : Config.Site, sel : Selector, hooks : Hook.Set) : Result(Unit, String) do
    run_core_with_hooks(cfg, sel, true, hooks)
  end

  fn run_pages_with_selector_and_hooks(cfg : Config.Site, sel : Selector, hooks : Hook.Set) : Result(Unit, String) do
    run_core_with_hooks(cfg, sel, false, hooks)
  end

  -- Like run_with_selector but uses a custom SiteIndex.IndexFn for the homepage.
  fn run_with_selector_and_index(cfg : Config.Site, sel : Selector, idx_fn) : Result(Unit, String) do
    run_core_with_index(cfg, sel, true, idx_fn)
  end

  -- Like run_with_selector_and_hooks but supplies a custom SiteIndex.IndexFn that
  -- generates the complete out/index.html document from the sorted post list.
  fn run_with_selector_hooks_and_index(cfg : Config.Site, sel : Selector, hooks : Hook.Set, idx_fn) : Result(Unit, String) do
    run_core_with_hooks_and_index(cfg, sel, true, hooks, idx_fn)
  end

  pfn run_core_with_hooks_and_index(cfg : Config.Site, sel : Selector, gen_collections : Bool, hooks : Hook.Set, idx_fn) : Result(Unit, String) do
    let before_hooks = hooks.before
    let after_hooks  = hooks.after
    match Hook.run_all(before_hooks) do
    Err(e) -> Err("before hook: " ++ e)
    Ok(_) ->
      match run_core_with_index(cfg, sel, gen_collections, idx_fn) do
      Err(e) -> Err(e)
      Ok(_) ->
        match Hook.run_all(after_hooks) do
        Err(e) -> Err("after hook: " ++ e)
        Ok(_)  -> Ok(())
        end
      end
    end
  end

  -- Private: run before hooks, delegate to run_core, run after hooks.
  -- Fields of hooks extracted before any match to keep Perceus counts correct.
  pfn run_core_with_hooks(cfg : Config.Site, sel : Selector, gen_collections : Bool, hooks : Hook.Set) : Result(Unit, String) do
    let before_hooks = hooks.before
    let after_hooks  = hooks.after
    match Hook.run_all(before_hooks) do
    Err(e) -> Err("before hook: " ++ e)
    Ok(_) ->
      match run_core(cfg, sel, gen_collections) do
      Err(e) -> Err(e)
      Ok(_) ->
        match Hook.run_all(after_hooks) do
        Err(e) -> Err("after hook: " ++ e)
        Ok(_)  -> Ok(())
        end
      end
    end
  end

  -- gen_collections gates pass 2b: true → blog mode, false → docs mode.
  -- Thin wrapper: delegates to run_core_impl with no custom index generator.
  fn run_core(cfg : Config.Site, sel : Selector, gen_collections : Bool) : Result(Unit, String) do
    run_core_impl(cfg, sel, gen_collections, None)
  end

  -- Like run_core but uses a caller-supplied SiteIndex.IndexFn to generate the
  -- homepage instead of the default bare-bones archive.
  pfn run_core_with_index(cfg : Config.Site, sel : Selector, gen_collections : Bool, idx_fn) : Result(Unit, String) do
    run_core_impl(cfg, sel, gen_collections, Some(idx_fn))
  end

  -- Private: the real two-pass build.  opt_idx_fn is threaded through to
  -- Collections.build_collections → write_index so that a custom homepage
  -- generator can be swapped in without duplicating the entire build pipeline.
  pfn run_core_impl(cfg : Config.Site, sel : Selector, gen_collections : Bool, opt_idx_fn) : Result(Unit, String) do
    -- Two-level extraction to work around Perceus RC bugs:
    -- Level 1: extract each field from cfg EXACTLY ONCE (5 uses of cfg total,
    --   in flat sequential let-bindings so Perceus counts them correctly).
    -- Level 2: derive all per-use owned copies from those owned Strings before
    --   any match branching (Perceus miscounts uses across match-arm boundaries).
    let content_dir = "" ++ Config.site_content_dir(cfg)
    let output_dir  = "" ++ Config.site_output_dir(cfg)
    let static_dir  = "" ++ Config.site_static_dir(cfg)
    let site_title  = "" ++ Config.site_title(cfg)
    let base_url    = "" ++ Config.site_base_url(cfg)
    -- Level 2: per-use copies, all derived before the first match.
    let content_dir_p1  = "" ++ content_dir
    let content_dir_r1  = "" ++ content_dir
    let content_root_p1 = "" ++ content_dir
    let content_dir_p2  = "" ++ content_dir
    let content_dir_r2  = "" ++ content_dir
    let content_root_p2 = "" ++ content_dir
    let output_dir_mk   = "" ++ output_dir
    let output_dir_p2a  = "" ++ output_dir
    let output_dir_p2b  = "" ++ output_dir
    let output_dir_cpy  = "" ++ output_dir
    match Dir.mkdir_p(output_dir_mk) do
    Err(e) -> Err("cannot create output dir: " ++ fmt_err(e))
    Ok(_) -> do
      -- Pass 1: list content_dir and build the site index.
      match Dir.list_full(content_dir_p1) do
      Err(e) -> Err("cannot list content dir: " ++ fmt_err(e))
      Ok(_) -> do
        -- collect_md does the real recursive gather on a fresh owned copy.
        let md_paths_p1 = collect_md(content_dir_r1)
        let idx         = collect_index(content_root_p1, md_paths_p1, SiteIndex.empty())
        -- Pass 2a: list content_dir again for the render pass.
        match Dir.list_full(content_dir_p2) do
        Err(e) -> Err("cannot list content dir (pass 2): " ++ fmt_err(e))
        Ok(_) -> do
          let md_paths_p2 = collect_md(content_dir_r2)
          -- Pass 2a: render pages.
          match build_all_layout(output_dir_p2a, content_root_p2, sel, md_paths_p2) do
          Err(msg) -> Err(msg)
          Ok(_) -> do
            -- Pass 2b: generate collections only in blog mode.
            match (if gen_collections do
                     Collections.build_collections(output_dir_p2b, site_title, base_url, idx, opt_idx_fn)
                   else Ok(()) end) do
            Err(msg) -> Err(msg)
            Ok(_) -> Assets.copy(static_dir, output_dir_cpy)
            end
          end
          end
        end
        end
      end
      end
    end
    end
  end

  -- Pass 1: collect index (reads content_dir independently of pass 2)
  -- Pass 2a: render pages
  -- Pass 2b: generate collections
  -- ─── Pass 1: collect site index ─────────────────────────────────────────────

  -- content_root is borrowed (only read by rel_slug); thread it through the walk
  -- exactly like a base_url, passing it to collect_one and the recursive step.
  pfn collect_index(content_root : String, paths : List(String), idx) do
    match paths do
    Nil -> idx
    Cons(src, rest) -> do
      let new_idx = collect_one(content_root, src, idx)
      collect_index(content_root, rest, new_idx)
    end
    end
  end

  pfn collect_one(content_root : String, src : String, idx) do
    -- RC note: src is a function parameter used in the scrutinee (File.read(src))
    -- AND in the Ok arm (Page.decode(src, ...) and rel_slug(content_root, src)).
    -- Pre-capture the slug and a decode closure BEFORE File.read so all three
    -- consuming uses of src are visible at the same scope level and Perceus
    -- inserts the right IncRCs.  content_root is borrowed by rel_slug.
    let slug    = rel_slug(content_root, src)
    let on_meta = fn ms -> Page.decode(src, ms)
    match File.read(src) do
    -- Don't swallow a read failure silently: warn so the index/sitemap/feed
    -- omission is visible (pass 2 separately surfaces it as a hard error).
    Err(_) -> do
      let _ = println("[sigil] warning: skipping unreadable file in index: " ++ slug)
      idx
    end
    Ok(content) -> do
      -- FrontMatter.split(content:own) consumes content once, yielding both the
      -- YAML for metadata and the body for the excerpt.
      match FrontMatter.split(content) do
      (meta_str, body) -> do
        let meta = on_meta(meta_str)
        let excerpt = excerpt_of(body)
        -- RC note: meta is consumed by Page.meta_draft before the match arm that uses
        -- SiteIndex.add.  Capture the add continuation before the draft check so both
        -- uses of meta are visible at the same scope level.
        let add_fn  = fn _ -> SiteIndex.add(idx, slug, excerpt, meta)
        let is_draft = Page.meta_draft(meta)
        let is_post  = String.starts_with(slug, "posts/")
        if is_draft || not(is_post) do idx else add_fn(()) end
      end
      end
    end
    end
  end

  -- ─── Pass 2a: render pages (parallel) ──────────────────────────────────────
  -- Fan out one green thread per page, then collect results.  All tasks run
  -- concurrently; wall-clock time is bounded by the slowest single file rather
  -- than the sum.  Order of error reporting is spawn order (first file first).
  pfn build_all_layout(output_dir : String, content_root : String, sel : Selector, paths : List(String)) : Result(Unit, String) do
    let tasks = spawn_layout_tasks(output_dir, content_root, sel, paths, Nil)
    await_layout_tasks(tasks)
  end

  -- Spawn one task per path.  Accumulates handles in reverse spawn order;
  -- await_layout_tasks reverses back so errors surface in file-list order.
  -- RC note: output_dir, content_root, and sel each appear twice per iteration
  -- (closure capture + recursive tail call).  All uses are sequential at the
  -- same scope level so Perceus inserts the right IncRCs automatically.
  pfn spawn_layout_tasks(output_dir : String, content_root : String, sel : Selector, paths : List(String), acc) do
    match paths do
    Nil -> acc
    Cons(src, rest) ->
      let out2  = "" ++ output_dir
      let root2 = "" ++ content_root
      let t     = task_spawn(fn _ -> build_page_layout(out2, root2, sel, src))
      spawn_layout_tasks(output_dir, content_root, sel, rest, Cons(t, acc))
    end
  end

  -- Await each handle in reverse-accumulation order (= original file order).
  -- Fail fast on the first error; remaining tasks continue to run in the
  -- background but their handles are dropped.
  pfn await_layout_tasks(tasks) : Result(Unit, String) do
    match tasks do
    Nil -> Ok(())
    Cons(t, rest) ->
      match task_await(t) do
      Err(e) -> Err(e)
      Ok(_)  -> await_layout_tasks(rest)
      end
    end
  end

  pfn build_page_layout(output_dir : String, content_root : String, sel : Selector, src : String) : Result(Unit, String) do
    -- RC note: src is a function parameter used in four places:
    -- 1) File.read(src) scrutinee (consuming if File.read is :own)
    -- 2) Err arm error message string
    -- 3) Ok arm: Page.decode(src, meta_str)
    -- 4) Ok arm: rel_slug(content_root, src)  <- pre-computed as slug at outer scope
    -- Pre-capture uses 2-4 as closures/values BEFORE File.read so all four
    -- consuming uses are at the same sequential scope level, letting Perceus
    -- insert 3 IncRCs for src.  content_root is borrowed by rel_slug.
    let slug    = rel_slug(content_root, src)
    let on_err  = fn e -> Err("cannot read " ++ src ++ ": " ++ fmt_err(e))
    let on_meta = fn ms -> Page.decode(src, ms)
    match File.read(src) do
    Err(e) -> on_err(e)
    Ok(content) -> do
      -- RC note: FrontMatter.split(content:own) consumes content in a single call.
      match FrontMatter.split(content) do
      (meta_str, body) -> do
        let meta = on_meta(meta_str)
        -- RC note: both first_heading_text and MdRender.render consume md_blocks.
        -- Placing both bindings at the same sequential scope makes both uses visible
        -- to Perceus.
        let md_blocks   = MdBlock.parse(body)
        let heading_opt = first_heading_text(md_blocks)
        let md_html     = MdRender.render(md_blocks)
        -- RC note: meta_draft/meta_title/has_title/meta_layout all BORROW meta;
        -- with_title OWNS it (last consuming use).  All five calls are at the same
        -- sequential scope with no closures capturing meta, so Perceus correctly
        -- sees that only with_title consumes meta and inserts no spurious early
        -- DecRCs.  meta_layout returns a fresh owned String, so layout_name stays
        -- valid after meta is consumed.
        let is_draft    = Page.meta_draft(meta)
        let raw_title   = Page.meta_title(meta)
        let has_title_b = Page.has_title(meta)
        let layout_name = Page.meta_layout(meta)
        let page_title  = if has_title_b do
                            raw_title
                          else
                            match heading_opt do
                            Some(t) -> t
                            None    -> raw_title
                            end
                          end
        -- Record the page's slug on the Meta so layouts can mark the active
        -- nav entry.  slug is also used for the output path below; Perceus
        -- inserts the IncRC for this first (borrowed-by-with_slug) use.
        let titled_meta = Page.with_title(meta, page_title)
        let final_meta  = Page.with_slug(titled_meta, slug)
        match is_draft do
        true  -> Ok(())
        false -> do
          -- Resolve the per-page LayoutFn from the selector using the page's
          -- layout name, then apply it.  sel is consumed here (last use).
          let lf   = apply_selector(sel, layout_name)
          let html = apply_layout(lf, final_meta, md_html)
          let out  = Path.join(output_dir, slug ++ ".html")
          -- A nested slug (e.g. "docs/intro") needs its parent directory created
          -- first.  Compute the parent by trimming at the last "/" (avoids the
          -- Path.dirname stdlib path helpers, which share the Some(0) crash bug).
          let out_parent = PathUtil.parent_dir(out)
          match Dir.mkdir_p(out_parent) do
          Err(e) -> Err("cannot create " ++ out_parent ++ ": " ++ fmt_err(e))
          Ok(_) ->
          match File.write(out, IOList.to_string(html)) do
          Err(e) -> Err("cannot write " ++ out ++ ": " ++ fmt_err(e))
          Ok(_)  -> Ok(())
          end
          end
        end
        end
      end
      end
    end
    end
  end

  -- ─── Excerpt helpers ─────────────────────────────────────────────────────────
  -- Compute a plain-text excerpt from a markdown body: parse to blocks, take the
  -- text of the first paragraph (falling back to the raw body when there is none),
  -- trim it, cap it at ~200 bytes, and neutralise any literal "]]>" so the result
  -- is safe to embed inside an RSS <![CDATA[ ... ]]> section.
  pfn excerpt_of(body : String) : String do
    let blocks = MdBlock.parse(body)
    let para   = first_paragraph_text(blocks)
    let raw =
      match para do
      Some(t) -> t
      None    -> body
      end
    cdata_safe(truncate_excerpt(String.trim(raw)))
  end

  -- Cap a string at ~200 bytes WITHOUT splitting a multibyte UTF-8 character.
  -- March has only byte-based slicing, so we cut at the last ASCII space within
  -- the first 200 bytes (a space is always a single-byte char boundary).  If
  -- there is no space in range (e.g. scriptless text), we keep the full string
  -- rather than risk slicing mid-character — the result is always valid UTF-8.
  pfn truncate_excerpt(s : String) : String do
    if String.byte_size(s) > 200 do
      let head = String.slice_bytes(s, 0, 200)
      match String.last_index_of(head, " ") do
      Some(i) -> String.slice_bytes(head, 0, i) ++ "…"
      None    -> s
      end
    else
      s
    end
  end

  -- Replace any literal "]]>" so the excerpt cannot terminate a CDATA section.
  pfn cdata_safe(s : String) : String do
    String.replace_all(s, "]]>", "]] >")
  end

  -- Extract the text of the first Para block from a list of parsed blocks.
  pfn first_paragraph_text(blocks : List(Block)) : Option(String) do
    match blocks do
    Nil -> None
    Cons(block, rest) -> do
      match block do
      Para(inlines) -> Some(inlines_to_text(inlines))
      _ -> first_paragraph_text(rest)
      end
    end
    end
  end

  -- ─── Heading text helpers ────────────────────────────────────────────────────
  -- Extract the text of the first Heading block from a list of parsed blocks.
  -- Uses unqualified constructor names to match March's type resolution rules.
  pfn first_heading_text(blocks : List(Block)) : Option(String) do
    match blocks do
    Nil -> None
    Cons(block, rest) -> do
      match block do
      Heading(_, _, inlines) -> Some(inlines_to_text(inlines))
      _ -> first_heading_text(rest)
      end
    end
    end
  end

  -- Concatenate the text content of a list of inline nodes.
  -- `Text` is qualified as `Inline.Text` because the stdlib Xml module also
  -- defines a `Text` constructor (on XmlNode); a bare `Text` pattern is
  -- ambiguous.
  -- Worklist accumulator: inner inline lists (Emph/Strong/Link children) are
  -- prepended to the remaining work so every call is in tail position.
  pfn inlines_to_text(inlines : List(Inline)) : String do
    inlines_to_text_go(inlines, "")
  end

  pfn inlines_to_text_go(work : List(Inline), acc : String) : String do
    match work do
    Nil -> acc
    Cons(inline, rest) ->
      match inline do
      Inline.Text(s)      -> inlines_to_text_go(rest, acc ++ s)
      Code(s)             -> inlines_to_text_go(rest, acc ++ s)
      Emph(inner)         -> inlines_to_text_go(List.append(inner, rest), acc)
      Strong(inner)       -> inlines_to_text_go(List.append(inner, rest), acc)
      Link(_, _, inner)   -> inlines_to_text_go(List.append(inner, rest), acc)
      Image(_, alt, _)    -> inlines_to_text_go(rest, acc ++ alt)
      HardBreak           -> inlines_to_text_go(rest, acc ++ " ")
      SoftBreak           -> inlines_to_text_go(rest, acc ++ " ")
      end
    end
  end

  -- ─── Public API ──────────────────────────────────────────────────────────────
  fn run(cfg : Config.Site) : Result(Unit, String) do
    run_with_selector(cfg, default_selector())
  end

end
