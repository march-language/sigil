mod Assets do

  needs IO.FileRead
  needs IO.FileWrite

  pfn fmt_err(e) : String do
    to_string(e)
  end

  -- Recursively copy static_dir to output_dir, MIRRORING the subdirectory tree
  -- (e.g. static/stdlib/Foo.html -> out/stdlib/Foo.html).  Creates output_dir if
  -- needed.  Returns Ok(()) if static_dir doesn't exist (optional feature).
  --
  -- `root` and `dest_root` are borrowed throughout (only concatenated into
  -- mirrored paths); each entry `src` is consumed once per iteration, mirroring
  -- the worklist discipline in Build.collect_md_walk.
  fn copy(static_dir : String, output_dir : String) : Result(Unit, String) do
    if not(Dir.exists(static_dir)) do
      Ok(())
    else
      match Dir.mkdir_p(output_dir) do
      Err(e) -> Err("cannot create output dir: " ++ fmt_err(e))
      Ok(_) ->
        -- A dedicated owned copy of static_dir for the listing; the originals
        -- are threaded as the (borrowed) mirror roots.
        let list_dir = "" ++ static_dir
        match Dir.list_full(list_dir) do
        Err(e) -> Err("cannot list static dir: " ++ fmt_err(e))
        Ok(paths) -> copy_all(static_dir, output_dir, paths)
        end
      end
    end
  end

  -- Worklist walk: directories are expanded into the front of the remaining work,
  -- files are copied immediately.  Every recursive call is in tail position.
  pfn copy_all(root : String, dest_root : String, paths : List(String)) : Result(Unit, String) do
    match paths do
    Nil -> Ok(())
    Cons(src, rest) ->
      if Dir.exists(src) do
        match Dir.list_full(src) do
        Err(e) -> Err("cannot list dir " ++ src ++ ": " ++ fmt_err(e))
        Ok(sub) -> copy_all(root, dest_root, List.append(sub, rest))
        end
      else
        match copy_file(root, dest_root, src) do
        Err(msg) -> Err(msg)
        Ok(_)    -> copy_all(root, dest_root, rest)
        end
      end
    end
  end

  pfn copy_file(root : String, dest_root : String, src : String) : Result(Unit, String) do
    -- Mirror the path relative to the static root into the output root.
    let rel = PathUtil.rel_under(root, src)
    let dst = Path.join(dest_root, rel)
    let dst_parent = PathUtil.parent_dir(dst)
    match Dir.mkdir_p(dst_parent) do
    Err(e) -> Err("cannot create " ++ dst_parent ++ ": " ++ fmt_err(e))
    Ok(_) ->
      match File.read(src) do
      Err(e) -> Err("cannot read " ++ src ++ ": " ++ fmt_err(e))
      Ok(content) ->
        match File.write(dst, content) do
        Err(e) -> Err("cannot write " ++ dst ++ ": " ++ fmt_err(e))
        Ok(_)  -> Ok(())
        end
      end
    end
  end

end
