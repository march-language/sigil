mod Serve do

  needs IO.Console
  needs IO.NetListen

  pfn reload_script() : String do
    "<script>" ++
    "const __ws=new WebSocket('ws://'+location.host+'/ws');" ++
    "__ws.onmessage=function(){location.reload();};" ++
    "</script>"
  end

  fn inject_reload(html : String) : String do
    String.replace(html, "</body>", reload_script() ++ "</body>")
  end

  -- Read the output directory from the process environment.
  -- Perceus RC workaround: captured values in HTTP-handler closures are consumed
  -- on the first request (Perceus treats closure captures as single-use moves).
  -- Using System.env() gives each request a fresh String with its own RC,
  -- completely bypassing the closure-capture lifetime issue.
  pfn get_output_dir() : String do
    match System.env("SIGIL_OUTPUT_DIR") do
    Some(d) -> d
    None    -> "out"
    end
  end

  -- A slug is safe to map to <output_dir>/<slug>.html only if it cannot escape
  -- the output directory: reject parent-dir segments (".."), an absolute/anchor
  -- leading "/", a Windows-style backslash separator, and the empty slug.  Nested
  -- forward-slash slugs (e.g. "docs/intro") are allowed — the build mirrors them
  -- into out/.  This is defence-in-depth: the router only forwards single path
  -- segments, but we do not rely on how HttpServer.path_info decodes/splits.
  fn safe_slug(slug : String) : Bool do
    if String.is_empty(slug) do false
    else if String.contains(slug, "..") do false
    else if String.contains(slug, "\\") do false
    else if String.starts_with(slug, "/") do false
    else true
    end end end end
  end

  pfn serve_page(slug : String, conn) do
    if not(safe_slug(slug)) do
      HttpServer.text(conn, 404, "Not Found")
    else
      let output_dir = get_output_dir()
      let path = Path.join(output_dir, slug ++ ".html")
      match File.read(path) do
      Err(_)   -> HttpServer.text(conn, 404, "Not Found")
      Ok(html) -> HttpServer.html(conn, 200, inject_reload(html))
      end
    end
  end

  pfn ws_handler(socket) do
    let output_dir = get_output_dir()
    let initial_v = Watcher.read_version(output_dir)
    ws_loop(output_dir, socket, initial_v)
  end

  pfn ws_loop(output_dir : String, socket, last_v : Int) : Unit do
    match WebSocket.select(socket, 300) do
    Timeout ->
      let v = Watcher.read_version(output_dir)
      if v != last_v do
        let _ = WebSocket.send_frame(socket, TextFrame("reload"))
        ws_loop(output_dir, socket, v)
      else
        ws_loop(output_dir, socket, last_v)
      end
    WsData(Close(_, _)) -> ()
    WsData(_)  -> ws_loop(output_dir, socket, last_v)
    ActorMsg   -> ws_loop(output_dir, socket, last_v)
    end
  end

  pfn router(conn) do
    -- Note: atom pattern matching (`match m do :get -> ...`) is broken in compiled
    -- binaries (the compiler always selects the wildcard arm).  Use == comparison
    -- on the atom value instead.
    let m = HttpServer.method(conn)
    let p = HttpServer.path_info(conn)
    if m == :get do
      match p do
      ["ws"] -> WebSocket.upgrade(conn, fn socket -> ws_handler(socket))
      []     -> serve_page("index", conn)
      [slug] -> serve_page(slug, conn)
      _      -> HttpServer.text(conn, 404, "Not Found")
      end
    else
      HttpServer.text(conn, 404, "Not Found")
    end
  end

  -- Perceus RC workaround: all RC-sensitive multi-use logic is concentrated in
  -- prun(), which receives content_dir/output_dir/static_dir as function parameters.
  -- Perceus correctly handles multiple uses of function-parameter strings (inserting
  -- incrc before each non-final use), unlike locally-extracted record fields.
  -- The public fn run() just extracts site fields and delegates to prun().
  --
  -- output_dir, static_dir, and content_dir are stored in process environment
  -- variables (SIGIL_OUTPUT_DIR, SIGIL_STATIC_DIR, SIGIL_CONTENT_DIR) so that the
  -- HTTP handler and watcher can read fresh copies per request/iteration via
  -- System.env(), avoiding Perceus single-call-closure RC underflow.
  --
  -- task_spawn uses a zero-capture lambda: fn _ -> Watcher.watch_env()
  -- Watcher.watch_env() reads SIGIL_CONTENT_DIR from the environment, so the
  -- closure has no heap-allocated fields for the march scheduler to RC-manage,
  -- which was the root cause of the previous crash in compiled binaries.
  pfn prun(content_dir : String, output_dir : String, static_dir : String, port : Int) : Unit do
    let _ = System.put_env("SIGIL_OUTPUT_DIR", output_dir)
    let _ = System.put_env("SIGIL_STATIC_DIR", static_dir)
    let _ = System.put_env("SIGIL_CONTENT_DIR", content_dir)
    let build_site = { content_dir: content_dir, output_dir: output_dir, static_dir: static_dir,
                       title: "", base_url: "" }
    let _ = Build.run(build_site)
    println("[sigil] built")
    -- Zero-capture lambda: fn _ -> Watcher.watch_env() captures no heap values.
    -- Watcher.watch_env reads SIGIL_CONTENT_DIR from the environment set above.
    let _ = task_spawn(fn _ -> Watcher.watch_env())
    println("[sigil] serving http://localhost:" ++ int_to_string(port))
    println("[sigil] press Ctrl+C to stop")
    -- Use http_server_listen directly instead of the HttpServer.plug/listen pipeline.
    -- The plug/listen path creates an intermediate closure that captures the plugs list;
    -- Perceus treats the plugs capture as single-use, so it is freed after the first
    -- request, causing RC underflow on the second.  Calling http_server_listen with
    -- our own stateless router closure (fn conn -> router(conn), no captures) avoids
    -- that closure-capture lifetime issue entirely.
    let _ = http_server_listen(port, 1000, 60, fn conn -> router(conn))
  end

  fn run(site : Config.Site, port : Int) : Unit do
    prun(site.content_dir, site.output_dir, site.static_dir, port)
  end

end
