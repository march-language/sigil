mod MdBlock do

  -- Parse a full Markdown document into a list of Block nodes.
  -- Note: signatures use unqualified `Block` / `Inline` rather than `Md.Block` / `Md.Inline`.
  -- Using qualified names in signatures causes the March type-checker to treat them as distinct
  -- from the constructor types in match arms, producing type errors.
  fn parse(src : String) : List(Block) do
    if String.is_empty(src) do Nil
    else
      let lines = String.split(src, "\n")
      -- Pre-pass: pull out link reference definitions ("[label]: url") so they
      -- (a) don't render as paragraph text and (b) are available to resolve
      -- [text][label] / [label][] / [label] references anywhere in the document.
      match extract_link_defs(lines, Nil, Nil) do
      (defs, content_lines) ->
        List.reverse(go(content_lines, Nil, Nil, defs))
      end
    end
  end

  -- Split lines into (link reference definitions, remaining content lines).
  -- Definition lines are removed from the content; they resolve references
  -- regardless of order (a definition may follow its use).
  pfn extract_link_defs(lines : List(String), defs_acc : List((String, String, String)), line_acc : List(String)) : (List((String, String, String)), List(String)) do
    match lines do
    Nil -> (List.reverse(defs_acc), List.reverse(line_acc))
    Cons(line, rest) ->
      match parse_link_def(line) do
      Some(def) -> extract_link_defs(rest, Cons(def, defs_acc), line_acc)
      None      -> extract_link_defs(rest, defs_acc, Cons(line, line_acc))
      end
    end
  end

  -- Parse one line as "[label]: dest" or "[label]: dest \"title\"", returning
  -- (label, dest, title) or None.  Title quotes may be \"...\", '...', or (...).
  pfn parse_link_def(line : String) : Option((String, String, String)) do
    let t = String.trim(line)
    if String.starts_with(t, "[") do
      match String.split_first(t, "]:") do
      None -> None
      Some(parts) ->
        match parts do
        (lhs, rhs) ->
          let label = String.slice_bytes(lhs, 1, String.byte_size(lhs) - 1)
          let body  = String.trim(rhs)
          if String.is_empty(label) || String.is_empty(body) do None
          else
            match String.split_first(body, " ") do
            None -> Some((label, body, ""))
            Some(dt) ->
              match dt do
              (dest, title_raw) ->
                Some((label, String.trim(dest), strip_quotes(String.trim(title_raw))))
              end
            end
          end
        end
      end
    else None
    end
  end

  -- Strip one matching pair of surrounding quotes: \"...\", '...', or (...).
  pfn strip_quotes(s : String) : String do
    let n = String.byte_size(s)
    if n >= 2 do
      let first = String.slice_bytes(s, 0, 1)
      let last  = String.slice_bytes(s, n - 1, 1)
      if (first == "\"" && last == "\"") || (first == "'" && last == "'") || (first == "(" && last == ")") do
        String.slice_bytes(s, 1, n - 2)
      else s
      end
    else s
    end
  end

  -- go: process lines into blocks.
  -- lines     : remaining lines
  -- para_acc  : accumulated paragraph lines (reversed)
  -- block_acc : completed blocks (reversed)
  --
  -- RC note: all three args are List(String) or List(Block) — no records.
  -- Each list is used at most once per branch before being passed to recursion.
  pfn go(lines : List(String), para_acc : List(String), block_acc : List(Block), defs : List((String, String, String))) : List(Block) do
    match lines do
    Nil ->
      flush_para(para_acc, block_acc, defs)
    Cons(line, rest) ->
      let trimmed = String.trim(line)
      if is_fence_open(trimmed) do
        let flushed = flush_para(para_acc, block_acc, defs)
        let fc   = fence_char(trimmed)
        let lang = fence_lang(trimmed)
        let (body, remaining) = collect_fence(rest, fc, Nil)
        go(remaining, Nil, Cons(CodeBlock(lang, body), flushed), defs)
      else if is_blockquote(trimmed) do
        -- M1 limitation: only the current (single) line is parsed as the blockquote content.
        -- Multi-line blockquotes (consecutive "> " lines merged) are not yet supported.
        let flushed = flush_para(para_acc, block_acc, defs)
        let stripped = strip_bq_prefix(trimmed)
        let bq_inlines = MdInline.parse_refs(stripped, defs)
        let inner = Cons(Para(bq_inlines), Nil)
        go(rest, Nil, Cons(Quote(inner), flushed), defs)
      else if is_ordered_item(trimmed) do
        let flushed = flush_para(para_acc, block_acc, defs)
        let start_num = ordered_item_number(trimmed)
        let (items, remaining) = collect_ordered(Cons(line, rest), Nil, defs)
        go(remaining, Nil, Cons(OrdList(start_num, items), flushed), defs)
      else if is_bullet_item(trimmed) do
        let flushed = flush_para(para_acc, block_acc, defs)
        let base0 = leading_indent(line)
        match collect_bullet_lines(Cons(line, rest), Nil) do
        (rows, remaining) ->
          match build_items(rows, base0, defs) do
          (items, _leftover) ->
            go(remaining, Nil, Cons(BulletList(items), flushed), defs)
          end
        end
      else if is_table_row(trimmed) do
        -- Lookahead: only treat as table if the very next line is a separator row.
        match rest do
        Cons(sep_line, data_lines) ->
          let sep_trimmed = String.trim(sep_line)
          if is_table_separator(sep_trimmed) do
            let flushed = flush_para(para_acc, block_acc, defs)
            let headers = map_parse_cells(split_table_row(trimmed), defs)
            let (data_rows, remaining) = collect_table_rows(data_lines, Nil, defs)
            go(remaining, Nil, Cons(Table(headers, data_rows), flushed), defs)
          else
            go(rest, Cons(line, para_acc), block_acc, defs)
          end
        _ ->
          go(rest, Cons(line, para_acc), block_acc, defs)
        end
      else if is_heading(trimmed) do
        let flushed = flush_para(para_acc, block_acc, defs)
        let h = parse_heading(trimmed, defs)
        go(rest, Nil, Cons(h, flushed), defs)
      else if is_setext_underline(trimmed) do
        -- A line of "=" (h1) or "-" (h2) immediately under paragraph text is a
        -- setext heading; with no preceding paragraph, "---" is a thematic break
        -- and "===" is just a paragraph line.
        match para_acc do
        Nil ->
          if only_char(trimmed, "-") do
            go(rest, Nil, Cons(ThematicBreak, block_acc), defs)
          else
            go(rest, Cons(line, Nil), block_acc, defs)
          end
        Cons(h, t) ->
          let level   = setext_level(trimmed)
          let raw     = String.join(List.reverse(Cons(h, t)), " ")
          let anchor  = make_anchor(raw)
          let inlines = MdInline.parse_refs(raw, defs)
          go(rest, Nil, Cons(Heading(level, anchor, inlines), block_acc), defs)
        end
      else if is_thematic_break(trimmed) do
        let flushed = flush_para(para_acc, block_acc, defs)
        go(rest, Nil, Cons(ThematicBreak, flushed), defs)
      else if String.is_empty(trimmed) do
        let flushed = flush_para(para_acc, block_acc, defs)
        go(rest, Nil, flushed, defs)
      else
        go(rest, Cons(line, para_acc), block_acc, defs)
      end end end end end end end end end
    end
  end

  pfn is_blockquote(line : String) : Bool do
    String.starts_with(line, "> ") || line == ">"
  end

  -- Strip the "> " prefix from a blockquote line.
  pfn strip_bq_prefix(line : String) : String do
    let n = String.byte_size(line)
    if String.starts_with(line, "> ") do String.slice_bytes(line, 2, n - 2)
    else if String.starts_with(line, ">") do String.slice_bytes(line, 1, n - 1)
    else line
    end end
  end

  pfn is_bullet_item(line : String) : Bool do
    String.starts_with(line, "- ") || String.starts_with(line, "* ")
  end

  -- Strip the "- " or "* " prefix from a bullet item line.
  pfn strip_bullet_prefix(line : String) : String do
    let n = String.byte_size(line)
    if String.starts_with(line, "- ") || String.starts_with(line, "* ") do
      String.slice_bytes(line, 2, n - 2)
    else
      line
    end
  end

  -- Phase 1: consume the run of consecutive bullet lines, recording each as an
  -- (indent, item_text) row.  A non-bullet line ends the run.
  pfn collect_bullet_lines(lines : List(String), acc : List((Int, String))) : (List((Int, String)), List(String)) do
    match lines do
    Nil -> (List.reverse(acc), Nil)
    Cons(line, rest) ->
      let ind = leading_indent(line)
      let t   = String.trim(line)
      if is_bullet_item(t) do
        let src = strip_bullet_prefix(String.trim(line))
        collect_bullet_lines(rest, Cons((ind, src), acc))
      else
        (List.reverse(acc), lines)
      end
    end
  end

  -- Phase 2: build list items at indentation `base` from the flat rows; rows
  -- indented deeper than an item become a nested BulletList inside it.
  pfn build_items(rows : List((Int, String)), base : Int, defs : List((String, String, String))) : (List(List(Block)), List((Int, String))) do
    build_items_acc(rows, base, Nil, defs)
  end

  -- Tail-recursive accumulator form (the self-recursion stays in tail position;
  -- March rejects a self-recursive call in a match scrutinee).
  pfn build_items_acc(rows : List((Int, String)), base : Int, acc : List(List(Block)), defs : List((String, String, String))) : (List(List(Block)), List((Int, String))) do
    match rows do
    Nil -> (List.reverse(acc), Nil)
    Cons(row, rest_rows) ->
      match row do
      (ind, text) ->
        if ind < base do
          (List.reverse(acc), Cons((ind, text), rest_rows))
        else
          let para = Para(MdInline.parse_refs(text, defs))
          match build_children(rest_rows, base, defs) do
          (children, rest_after) ->
            let item_blocks = Cons(para, children)
            build_items_acc(rest_after, base, Cons(item_blocks, acc), defs)
          end
        end
      end
    end
  end

  -- If the next rows are indented deeper than `parent_base`, build them into a
  -- nested BulletList block; otherwise no children.
  pfn build_children(rows : List((Int, String)), parent_base : Int, defs : List((String, String, String))) : (List(Block), List((Int, String))) do
    match rows do
    Nil -> (Nil, Nil)
    Cons(row, rest_rows) ->
      match row do
      (ind, text) ->
        if ind > parent_base do
          match build_items(Cons((ind, text), rest_rows), ind, defs) do
          (items, rest) -> (Cons(BulletList(items), Nil), rest)
          end
        else
          (Nil, Cons((ind, text), rest_rows))
        end
      end
    end
  end

  -- Number of leading space bytes on a line (its indentation depth).
  pfn leading_indent(line : String) : Int do
    indent_loop(line, String.byte_size(line), 0)
  end

  pfn indent_loop(s : String, n : Int, i : Int) : Int do
    if i >= n do i
    else if String.slice_bytes(s, i, 1) == " " do indent_loop(s, n, i + 1)
    else i
    end end
  end

  -- True if a line looks like an ordered list item: one or more digits followed by ". ".
  pfn is_ordered_item(line : String) : Bool do
    let n = String.byte_size(line)
    if n < 3 do false
    else is_ordered_item_from(line, n, 0)
    end
  end

  pfn is_ordered_item_from(line : String, n : Int, i : Int) : Bool do
    if i >= n do false
    else
      let c = String.slice_bytes(line, i, 1)
      let code = byte_to_code(c)
      if code >= 48 && code <= 57 do
        -- digit: keep scanning
        is_ordered_item_from(line, n, i + 1)
      else if c == "." && i > 0 && i + 1 < n && String.slice_bytes(line, i + 1, 1) == " " do
        true
      else
        false
      end end
    end
  end

  -- Extract the number from an ordered list item like "3. text" → 3.
  pfn ordered_item_number(line : String) : Int do
    ordered_digits(line, String.byte_size(line), 0, 0)
  end

  pfn ordered_digits(line : String, n : Int, i : Int, acc : Int) : Int do
    if i >= n do acc
    else
      let c = String.slice_bytes(line, i, 1)
      let code = byte_to_code(c)
      if code >= 48 && code <= 57 do
        ordered_digits(line, n, i + 1, acc * 10 + (code - 48))
      else acc
      end
    end
  end

  -- Strip the "N. " prefix from an ordered list item.
  pfn strip_ordered_prefix(line : String) : String do
    let n = String.byte_size(line)
    strip_ordered_from(line, n, 0)
  end

  pfn strip_ordered_from(line : String, n : Int, i : Int) : String do
    if i >= n do line
    else
      let c = String.slice_bytes(line, i, 1)
      let code = byte_to_code(c)
      if code >= 48 && code <= 57 do
        strip_ordered_from(line, n, i + 1)
      else if c == "." && i + 2 <= n do
        String.slice_bytes(line, i + 2, n - i - 2)
      else line
      end end
    end
  end

  -- Collect consecutive ordered list items.
  pfn collect_ordered(lines : List(String), acc : List(List(Block)), defs : List((String, String, String))) : (List(List(Block)), List(String)) do
    match lines do
    Nil -> (List.reverse(acc), Nil)
    Cons(line, rest) ->
      let t = String.trim(line)
      if is_ordered_item(t) do
        let item_src = strip_ordered_prefix(String.trim(line))
        let inlines = MdInline.parse_refs(item_src, defs)
        let item_blocks = Cons(Para(inlines), Nil)
        collect_ordered(rest, Cons(item_blocks, acc), defs)
      else
        (List.reverse(acc), lines)
      end
    end
  end

  -- True if a line looks like a table row (contains at least one `|`).
  pfn is_table_row(line : String) : Bool do
    has_pipe(line, String.byte_size(line), 0)
  end

  pfn has_pipe(s : String, n : Int, i : Int) : Bool do
    if i >= n do false
    else if String.slice_bytes(s, i, 1) == "|" do true
    else has_pipe(s, n, i + 1)
    end end
  end

  -- True if a line is a table separator row (only -, |, :, and spaces).
  pfn is_table_separator(line : String) : Bool do
    let n = String.byte_size(line)
    if n < 3 do false
    else is_table_sep_from(line, n, 0, false)
    end
  end

  -- Scan a potential separator line: must contain at least one '-'.
  pfn is_table_sep_from(line : String, n : Int, i : Int, seen_dash : Bool) : Bool do
    if i >= n do seen_dash
    else
      let c = String.slice_bytes(line, i, 1)
      if c == "-" do is_table_sep_from(line, n, i + 1, true)
      else if c == "|" || c == ":" || c == " " do
        is_table_sep_from(line, n, i + 1, seen_dash)
      else false
      end end
    end
  end

  -- Split a pipe-separated table row into trimmed cell strings.
  -- "|A|B|C|" → ["A","B","C"],  "A|B|C" → ["A","B","C"]
  pfn split_table_row(line : String) : List(String) do
    let n  = String.byte_size(line)
    -- strip leading/trailing `|` before splitting
    let start = if n > 0 && String.slice_bytes(line, 0, 1) == "|" do 1 else 0 end
    let end_  = if n > 0 && String.slice_bytes(line, n - 1, 1) == "|" do n - 1 else n end
    let inner = String.slice_bytes(line, start, end_ - start)
    List.reverse(split_on_pipe(inner, String.byte_size(inner), 0, 0, Nil))
  end

  pfn split_on_pipe(s : String, n : Int, pos : Int, cell_start : Int, acc : List(String)) : List(String) do
    if pos >= n do
      let cell = String.trim(String.slice_bytes(s, cell_start, n - cell_start))
      if String.is_empty(cell) do acc
      else Cons(cell, acc)
      end
    else if String.slice_bytes(s, pos, 1) == "|" do
      let cell = String.trim(String.slice_bytes(s, cell_start, pos - cell_start))
      split_on_pipe(s, n, pos + 1, pos + 1, Cons(cell, acc))
    else
      split_on_pipe(s, n, pos + 1, cell_start, acc)
    end end
  end

  -- Map a list of cell strings through MdInline.parse.
  pfn map_parse_cells(cells : List(String), defs : List((String, String, String))) : List(List(Inline)) do
    match cells do
    Nil -> Nil
    Cons(c, rest) -> Cons(MdInline.parse_refs(String.trim(c), defs), map_parse_cells(rest, defs))
    end
  end

  -- Collect consecutive table rows (lines that contain `|`).
  pfn collect_table_rows(lines : List(String), acc : List(List(List(Inline))), defs : List((String, String, String))) : (List(List(List(Inline))), List(String)) do
    match lines do
    Nil -> (List.reverse(acc), Nil)
    Cons(line, rest) ->
      let t = String.trim(line)
      if is_table_row(t) do
        let row = map_parse_cells(split_table_row(t), defs)
        collect_table_rows(rest, Cons(row, acc), defs)
      else
        (List.reverse(acc), lines)
      end
    end
  end

  -- A line is a fence opener if it starts with 3+ backticks or 3+ tildes.
  pfn is_fence_open(line : String) : Bool do
    String.starts_with(line, "```") || String.starts_with(line, "~~~")
  end

  -- Get the fence character ("`" or "~") from an opener line.
  pfn fence_char(line : String) : String do
    String.slice_bytes(line, 0, 1)
  end

  -- Get the language tag from a fence opener (everything after the opening ```).
  pfn fence_lang(line : String) : String do
    let n = String.byte_size(line)
    String.trim(String.slice_bytes(line, 3, n - 3))
  end

  -- Collect lines until a closing fence (line of 3+ fence_char, nothing else).
  -- Returns (body_string, remaining_lines_after_closer).
  pfn collect_fence(lines : List(String), fc : String, body_acc : List(String)) : (String, List(String)) do
    match lines do
    Nil ->
      -- Unclosed fence: everything so far is the body
      (String.join(List.reverse(body_acc), "\n"), Nil)
    Cons(line, rest) ->
      let trimmed = String.trim(line)
      let is_close = is_fence_close(trimmed, fc)
      if is_close do
        (String.join(List.reverse(body_acc), "\n"), rest)
      else
        collect_fence(rest, fc, Cons(line, body_acc))
      end
    end
  end

  -- A closing fence is 3+ of the same fence char and nothing else.
  pfn is_fence_close(line : String, fc : String) : Bool do
    let n = String.byte_size(line)
    if n < 3 do false
    else only_char(line, fc)
    end
  end

  -- Emit a Para block from accumulated lines if non-empty.
  pfn flush_para(para_acc : List(String), block_acc : List(Block), defs : List((String, String, String))) : List(Block) do
    match para_acc do
    Nil -> block_acc
    _   ->
      -- Join wrapped paragraph lines with a space (a CommonMark soft break), not a
      -- literal "\n" — the inline parser treats "\n" as ordinary text, which would
      -- leave a raw newline in the <p> source.  (Hard breaks — two trailing spaces
      -- → <br> — are not yet supported.)
      let content = String.join(List.reverse(para_acc), " ")
      let inlines = MdInline.parse_refs(content, defs)
      Cons(Para(inlines), block_acc)
    end
  end

  -- A line is an ATX heading if it starts with 1-6 `#` followed by space or end of line.
  pfn is_heading(line : String) : Bool do
    String.starts_with(line, "# ")  ||
    String.starts_with(line, "## ") ||
    String.starts_with(line, "### ") ||
    String.starts_with(line, "#### ") ||
    String.starts_with(line, "##### ") ||
    String.starts_with(line, "###### ") ||
    line == "#" || line == "##" || line == "###" ||
    line == "####" || line == "#####" || line == "######"
  end

  -- Parse an ATX heading line into a Heading block.
  pfn parse_heading(line : String, defs : List((String, String, String))) : Block do
    let level = count_hashes(line, 0)
    let clamped = if level < 1 do 1 else if level > 6 do 6 else level end end
    -- Drop the hash prefix; trim leading/trailing space from the content
    let n = String.byte_size(line)
    let raw = String.trim(String.slice_bytes(line, clamped, n - clamped))
    let anchor = make_anchor(raw)
    let inlines = MdInline.parse_refs(raw, defs)
    Heading(clamped, anchor, inlines)
  end

  -- Count leading '#' characters (tail-recursive).
  pfn count_hashes(s : String, n : Int) : Int do
    if String.byte_size(s) > n && String.slice_bytes(s, n, 1) == "#" do
      count_hashes(s, n + 1)
    else
      n
    end
  end

  -- A setext underline is a non-empty line of all "=" (h1) or all "-" (h2),
  -- with no internal spaces (a spaced "- - -" is a thematic break, not setext).
  pfn is_setext_underline(t : String) : Bool do
    not(String.is_empty(t)) && (only_char(t, "=") || only_char(t, "-"))
  end

  pfn setext_level(t : String) : Int do
    if only_char(t, "=") do 1 else 2 end
  end

  -- A thematic break is 3+ identical chars from {-, *, _} (spaces allowed, nothing else).
  pfn is_thematic_break(line : String) : Bool do
    let stripped = String.replace_all(String.replace_all(line, " ", ""), "\t", "")
    let n = String.byte_size(stripped)
    if n < 3 do false
    else
      let first = String.slice_bytes(stripped, 0, 1)
      (first == "-" || first == "*" || first == "_") && only_char(stripped, first)
    end
  end

  -- True if every byte of s equals ch.
  pfn only_char(s : String, ch : String) : Bool do
    only_char_from(s, ch, 0, String.byte_size(s))
  end

  pfn only_char_from(s : String, ch : String, i : Int, n : Int) : Bool do
    if i >= n do true
    else if String.slice_bytes(s, i, 1) == ch do only_char_from(s, ch, i + 1, n)
    else false
    end end
  end

  -- Convert a heading text to an anchor slug: lowercase, spaces->hyphens, keep [a-z0-9-].
  -- Uses byte-level scanning since String.chars is not available.
  pfn make_anchor(text : String) : String do
    let lower = String.to_lowercase(text)
    let hyphenated = String.replace_all(lower, " ", "-")
    let n = String.byte_size(hyphenated)
    anchor_loop(hyphenated, n, 0, "")
  end

  pfn anchor_loop(s : String, n : Int, i : Int, acc : String) : String do
    if i >= n do acc
    else
      let byte = String.slice_bytes(s, i, 1)
      let code = byte_to_code(byte)
      let keep =
        (code >= 97 && code <= 122) ||
        (code >= 48 && code <= 57)  ||
        code == 45
      if keep do anchor_loop(s, n, i + 1, acc ++ byte)
      else anchor_loop(s, n, i + 1, acc)
      end
    end
  end

  -- Map a single-byte string to its ASCII code point.
  pfn byte_to_code(b : String) : Int do
    if b == "a" do 97
    else if b == "b" do 98
    else if b == "c" do 99
    else if b == "d" do 100
    else if b == "e" do 101
    else if b == "f" do 102
    else if b == "g" do 103
    else if b == "h" do 104
    else if b == "i" do 105
    else if b == "j" do 106
    else if b == "k" do 107
    else if b == "l" do 108
    else if b == "m" do 109
    else if b == "n" do 110
    else if b == "o" do 111
    else if b == "p" do 112
    else if b == "q" do 113
    else if b == "r" do 114
    else if b == "s" do 115
    else if b == "t" do 116
    else if b == "u" do 117
    else if b == "v" do 118
    else if b == "w" do 119
    else if b == "x" do 120
    else if b == "y" do 121
    else if b == "z" do 122
    else if b == "0" do 48
    else if b == "1" do 49
    else if b == "2" do 50
    else if b == "3" do 51
    else if b == "4" do 52
    else if b == "5" do 53
    else if b == "6" do 54
    else if b == "7" do 55
    else if b == "8" do 56
    else if b == "9" do 57
    else if b == "-" do 45
    else 0
    end end end end end end end end end end end end end end end end end end end
    end end end end end end end end end end end end end end end end end end
  end

end
