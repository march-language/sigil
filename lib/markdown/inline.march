mod MdInline do

  -- Parse a string into a list of inline nodes.
  -- Uses byte-level scanning.
  fn parse(s : String) : List(Inline) do
    let n = String.byte_size(s)
    if n == 0 do Nil
    else List.reverse(scan_run(s, n, 0, 0, Nil))
    end
  end

  -- Inner scanner: handles only backtick code spans (no emph/strong nesting).
  -- This avoids mutual recursion that would create a non-tail cycle.
  pfn scan_inner(s : String, n : Int, pos : Int, text_start : Int, acc : List(Inline)) : List(Inline) do
    if pos >= n do
      let tlen = n - text_start
      if tlen == 0 do acc
      else Cons(Md.Inline.Text(String.slice_bytes(s, text_start, tlen)), acc)
      end
    else
      let ich = String.slice_bytes(s, pos, 1)
      if ich == "`" do
        match find_byte(s, n, pos + 1, "`") do
        None ->
          scan_inner(s, n, pos + 1, text_start, acc)
        Some(ic_close) ->
          let ic_acc = flush_text(s, text_start, pos, acc)
          let ic_code = String.slice_bytes(s, pos + 1, ic_close - pos - 1)
          scan_inner(s, n, ic_close + 1, ic_close + 1, Cons(Code(ic_code), ic_acc))
        end
      else if ich == "\\" && pos + 1 < n && is_escapable(String.slice_bytes(s, pos + 1, 1)) do
        let ic_esc_acc = flush_text(s, text_start, pos, acc)
        let ic_esc     = String.slice_bytes(s, pos + 1, 1)
        scan_inner(s, n, pos + 2, pos + 2, Cons(Md.Inline.Text(ic_esc), ic_esc_acc))
      else
        scan_inner(s, n, pos + 1, text_start, acc)
      end end
    end
  end

  -- Parse inner span content (e.g. body of *...*).
  -- Uses scan_inner which does NOT recurse back through scan_run.
  pfn parse_span(s : String) : List(Inline) do
    let n = String.byte_size(s)
    if n == 0 do Nil
    else List.reverse(scan_inner(s, n, 0, 0, Nil))
    end
  end

  -- Walk bytes of s, accumulating inline nodes in reverse order.
  -- pos: current scan position.
  -- text_start: start of the current plain-text run.
  -- acc: reversed result list (call List.reverse at the end).
  pfn scan_run(s : String, n : Int, pos : Int, text_start : Int, acc : List(Inline)) : List(Inline) do
    if pos >= n do
      let tail_len = n - text_start
      if tail_len == 0 do acc
      else Cons(Md.Inline.Text(String.slice_bytes(s, text_start, tail_len)), acc)
      end
    else
      let ch = String.slice_bytes(s, pos, 1)
      if ch == "`" do
        match find_byte(s, n, pos + 1, "`") do
        None ->
          scan_run(s, n, pos + 1, text_start, acc)
        Some(btick_close) ->
          let bt_acc = flush_text(s, text_start, pos, acc)
          let bt_code = String.slice_bytes(s, pos + 1, btick_close - pos - 1)
          scan_run(s, n, btick_close + 1, btick_close + 1, Cons(Code(bt_code), bt_acc))
        end
      else if ch == "!" && pos + 1 < n && String.slice_bytes(s, pos + 1, 1) == "[" do
        -- Possible image: ![alt](url) or ![alt](url "title")
        match find_byte(s, n, pos + 2, "]") do
        None -> scan_run(s, n, pos + 1, text_start, acc)
        Some(img_close) ->
          if img_close + 1 < n && String.slice_bytes(s, img_close + 1, 1) == "(" do
            match find_byte(s, n, img_close + 2, ")") do
            None -> scan_run(s, n, pos + 1, text_start, acc)
            Some(img_paren_close) ->
              let img_alt = String.slice_bytes(s, pos + 2, img_close - pos - 2)
              let img_dest_raw = String.slice_bytes(s, img_close + 2, img_paren_close - img_close - 2)
              -- Single-use tuple destructure avoids double-ownership of the pair.
              let (img_url, img_title) = parse_link_dest(img_dest_raw)
              let img_acc = flush_text(s, text_start, pos, acc)
              scan_run(s, n, img_paren_close + 1, img_paren_close + 1,
                Cons(Image(img_url, img_alt, img_title), img_acc))
            end
          else
            scan_run(s, n, pos + 1, text_start, acc)
          end
        end
      else if ch == "[" do
        -- Possible link: [text](url) or [text](url "title")
        match find_byte(s, n, pos + 1, "]") do
        None -> scan_run(s, n, pos + 1, text_start, acc)
        Some(link_close) ->
          if link_close + 1 < n && String.slice_bytes(s, link_close + 1, 1) == "(" do
            match find_byte(s, n, link_close + 2, ")") do
            None -> scan_run(s, n, pos + 1, text_start, acc)
            Some(link_paren_close) ->
              let link_text = String.slice_bytes(s, pos + 1, link_close - pos - 1)
              let link_dest_raw = String.slice_bytes(s, link_close + 2, link_paren_close - link_close - 2)
              -- Single-use tuple destructure avoids double-ownership of the pair.
              let (link_url, link_title) = parse_link_dest(link_dest_raw)
              let link_kids = parse_span(link_text)
              let link_acc = flush_text(s, text_start, pos, acc)
              scan_run(s, n, link_paren_close + 1, link_paren_close + 1,
                Cons(Link(link_url, link_title, link_kids), link_acc))
            end
          else
            scan_run(s, n, pos + 1, text_start, acc)
          end
        end
      else if ch == "*" do
        let next_star =
          if pos + 1 < n do String.slice_bytes(s, pos + 1, 1) == "*"
          else false
          end
        if next_star do
          match find_seq(s, n, pos + 2, "**", 2) do
          None    -> scan_run(s, n, pos + 1, text_start, acc)
          Some(st_close) ->
            let st_acc = flush_text(s, text_start, pos, acc)
            let st_body = String.slice_bytes(s, pos + 2, st_close - pos - 2)
            let st_kids = parse_span(st_body)
            scan_run(s, n, st_close + 2, st_close + 2, Cons(Strong(st_kids), st_acc))
          end
        else
          match find_byte_unesc(s, n, pos + 1, "*") do
          None    -> scan_run(s, n, pos + 1, text_start, acc)
          Some(em_close) ->
            let em_acc = flush_text(s, text_start, pos, acc)
            let em_body = String.slice_bytes(s, pos + 1, em_close - pos - 1)
            let em_kids = parse_span(em_body)
            scan_run(s, n, em_close + 1, em_close + 1, Cons(Emph(em_kids), em_acc))
          end
        end
      else if ch == "_" do
        -- __strong__ or _emph_ (underscore variants)
        let next_under =
          if pos + 1 < n do String.slice_bytes(s, pos + 1, 1) == "_"
          else false
          end
        if next_under do
          match find_seq(s, n, pos + 2, "__", 2) do
          None    -> scan_run(s, n, pos + 1, text_start, acc)
          Some(us_close) ->
            let us_acc = flush_text(s, text_start, pos, acc)
            let us_body = String.slice_bytes(s, pos + 2, us_close - pos - 2)
            let us_kids = parse_span(us_body)
            scan_run(s, n, us_close + 2, us_close + 2, Cons(Strong(us_kids), us_acc))
          end
        else
          -- Underscore emphasis needs a word boundary: an opener preceded by an
          -- alphanumeric (the "_" in snake_case) is intra-word and stays literal.
          -- Asterisk emphasis has no such restriction.
          let prev_alnum = if pos > 0 do is_alnum(String.slice_bytes(s, pos - 1, 1)) else false end
          if prev_alnum do
            scan_run(s, n, pos + 1, text_start, acc)
          else
            match find_us_close(s, n, pos + 1) do
            None    -> scan_run(s, n, pos + 1, text_start, acc)
            Some(ue_close) ->
              let ue_acc = flush_text(s, text_start, pos, acc)
              let ue_body = String.slice_bytes(s, pos + 1, ue_close - pos - 1)
              let ue_kids = parse_span(ue_body)
              scan_run(s, n, ue_close + 1, ue_close + 1, Cons(Emph(ue_kids), ue_acc))
            end
          end
        end
      else if ch == "\\" && pos + 1 < n && is_escapable(String.slice_bytes(s, pos + 1, 1)) do
        -- Backslash escape: emit the next char literally, skipping any markup it
        -- would otherwise start (e.g. \* is a literal asterisk, not emphasis).
        let esc_acc  = flush_text(s, text_start, pos, acc)
        let esc_char = String.slice_bytes(s, pos + 1, 1)
        scan_run(s, n, pos + 2, pos + 2, Cons(Md.Inline.Text(esc_char), esc_acc))
      else
        scan_run(s, n, pos + 1, text_start, acc)
      end end end end end end
    end
  end

  -- True for the ASCII-punctuation chars a backslash may escape (CommonMark).
  pfn is_escapable(c : String) : Bool do
    String.contains("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", c)
  end

  -- True for an ASCII alphanumeric byte (membership test avoids relying on
  -- string ordering comparisons).
  pfn is_alnum(c : String) : Bool do
    String.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", c)
  end

  -- Find an unescaped "_" that can CLOSE underscore emphasis: per CommonMark an
  -- intra-word "_" is not a valid closer, so skip any "_" immediately followed by
  -- an alphanumeric (e.g. the middle "_" in "_b_c_").
  pfn find_us_close(s : String, n : Int, start : Int) : Option(Int) do
    match find_byte_unesc(s, n, start, "_") do
    None -> None
    Some(p) ->
      let after_alnum = if p + 1 < n do is_alnum(String.slice_bytes(s, p + 1, 1)) else false end
      if after_alnum do find_us_close(s, n, p + 1)
      else Some(p)
      end
    end
  end

  -- Emit a Text node for bytes [from, to) if non-empty.
  pfn flush_text(s : String, from : Int, to : Int, acc : List(Inline)) : List(Inline) do
    let flen = to - from
    if flen == 0 do acc
    else Cons(Md.Inline.Text(String.slice_bytes(s, from, flen)), acc)
    end
  end

  -- Find the first occurrence of a single-byte marker at or after `start`.
  pfn find_byte(s : String, n : Int, start : Int, marker : String) : Option(Int) do
    if start >= n do None
    else if String.slice_bytes(s, start, 1) == marker do Some(start)
    else find_byte(s, n, start + 1, marker)
    end end
  end

  -- Like find_byte but skips a marker that is backslash-escaped (preceded by a
  -- single "\").  Used to find an emphasis closer so that e.g. *x\*y* treats the
  -- middle "\*" as a literal and closes on the final "*".
  pfn find_byte_unesc(s : String, n : Int, start : Int, marker : String) : Option(Int) do
    if start >= n do None
    else if String.slice_bytes(s, start, 1) == marker do
      if start > 0 && String.slice_bytes(s, start - 1, 1) == "\\" do
        find_byte_unesc(s, n, start + 1, marker)
      else Some(start)
      end
    else find_byte_unesc(s, n, start + 1, marker)
    end end
  end

  -- Parse a link destination string: "url" or "url \"title\"" or "url 'title'".
  -- Returns a (url, title) tuple — destructure with `let (url, title) = ...` to
  -- avoid double-ownership of the value (using it twice triggers Perceus RC underflow).
  pfn parse_link_dest(raw : String) : (String, String) do
    let r = String.trim(raw)
    let rn = String.byte_size(r)
    match find_title_start(r, rn) do
    None    -> (r, "")
    Some(i) ->
      let url   = String.trim(String.slice_bytes(r, 0, i))
      let title = extract_title(r, i, rn)
      (url, title)
    end
  end

  -- Find the byte index of the title-quote opener (a space followed by " or ').
  -- Returns Some(index_of_space) if found, None otherwise.
  pfn find_title_start(s : String, n : Int) : Option(Int) do
    find_title_start_from(s, n, 0)
  end

  pfn find_title_start_from(s : String, n : Int, i : Int) : Option(Int) do
    if i >= n do None
    else
      let c = String.slice_bytes(s, i, 1)
      if c == " " && i + 1 < n do
        let nxt = String.slice_bytes(s, i + 1, 1)
        if nxt == "\"" || nxt == "'" do Some(i)
        else find_title_start_from(s, n, i + 1)
        end
      else find_title_start_from(s, n, i + 1)
      end
    end
  end

  -- Extract the title content from inside its quotes, given the space position.
  pfn extract_title(s : String, space_i : Int, n : Int) : String do
    let q = String.slice_bytes(s, space_i + 1, 1)
    let inner_start = space_i + 2
    let inner_len   = n - inner_start - 1  -- chop the closing quote
    if inner_len <= 0 do ""
    else String.slice_bytes(s, inner_start, inner_len)
    end
  end

  -- Find the first occurrence of a multi-byte marker at or after `pos`.
  pfn find_seq(s : String, n : Int, pos : Int, marker : String, mlen : Int) : Option(Int) do
    if pos + mlen > n do None
    else if String.slice_bytes(s, pos, mlen) == marker do Some(pos)
    else find_seq(s, n, pos + 1, marker, mlen)
    end end
  end

end
