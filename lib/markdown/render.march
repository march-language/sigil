mod MdRender do

  -- Note: signatures use unqualified `Block` / `Inline` rather than `Md.Block` / `Md.Inline`.
  -- Using qualified names in signatures causes the March type-checker to treat them as distinct
  -- from the constructor types in match arms, producing type errors. Unqualified names resolve
  -- correctly because `MdRender` shares the same compilation unit as `Md`.

  fn render(blocks : List(Block)) : IOList do
    Html.list(blocks, fn b -> render_block(b))
  end

  pfn render_block(block : Block) : IOList do
    match block do
    Heading(level, id, inlines) ->
      let clamped = if level < 1 do 1 else if level > 6 do 6 else level end end
      let tag = "h" ++ int_to_string(clamped)
      let open_tag = "<" ++ tag ++ " id=\"" ++ Html.escape_attr(id) ++ "\">"
      let close_tag = "</" ++ tag ++ ">"
      IOList.from_string(open_tag)
      |> IOList.append(render_inlines(inlines))
      |> IOList.append(IOList.from_string(close_tag))
    Para(inlines) ->
      IOList.from_string("<p>")
      |> IOList.append(render_inlines(inlines))
      |> IOList.append(IOList.from_string("</p>"))
    CodeBlock(lang, body) ->
      let escaped = Html.escape(body)
      let class_attr = if String.is_empty(lang) do ""
                       else " class=\"language-" ++ Html.escape_attr(lang) ++ "\""
                       end
      IOList.from_string("<pre><code" ++ class_attr ++ ">")
      |> IOList.append(IOList.from_string(escaped))
      |> IOList.append(IOList.from_string("</code></pre>"))
    BulletList(items) ->
      IOList.from_string("<ul>")
      |> IOList.append(Html.list(items, fn item -> render_item(item)))
      |> IOList.append(IOList.from_string("</ul>"))
    OrdList(start, items) ->
      let attr = if start == 1 do "" else " start=\"" ++ int_to_string(start) ++ "\"" end
      IOList.from_string("<ol" ++ attr ++ ">")
      |> IOList.append(Html.list(items, fn item -> render_item(item)))
      |> IOList.append(IOList.from_string("</ol>"))
    Quote(inner) ->
      IOList.from_string("<blockquote>")
      |> IOList.append(render(inner))
      |> IOList.append(IOList.from_string("</blockquote>"))
    ThematicBreak ->
      IOList.from_string("<hr>")
    RawHtml(html) ->
      IOList.from_string(html)
    Table(headers, rows) ->
      let th_cells = Html.list(headers, fn cell ->
        IOList.from_string("<th>")
        |> IOList.append(render_inlines(cell))
        |> IOList.append(IOList.from_string("</th>"))
      )
      let thead =
        IOList.from_string("<thead><tr>")
        |> IOList.append(th_cells)
        |> IOList.append(IOList.from_string("</tr></thead>"))
      let tbody_rows = Html.list(rows, fn row ->
        let td_cells = Html.list(row, fn cell ->
          IOList.from_string("<td>")
          |> IOList.append(render_inlines(cell))
          |> IOList.append(IOList.from_string("</td>"))
        )
        IOList.from_string("<tr>")
        |> IOList.append(td_cells)
        |> IOList.append(IOList.from_string("</tr>"))
      )
      let tbody =
        IOList.from_string("<tbody>")
        |> IOList.append(tbody_rows)
        |> IOList.append(IOList.from_string("</tbody>"))
      IOList.from_string("<table>")
      |> IOList.append(thead)
      |> IOList.append(tbody)
      |> IOList.append(IOList.from_string("</table>"))
    end
  end

  pfn render_item(blocks : List(Block)) : IOList do
    IOList.from_string("<li>")
    |> IOList.append(render(blocks))
    |> IOList.append(IOList.from_string("</li>"))
  end

  fn render_inlines(inlines : List(Inline)) : IOList do
    Html.list(inlines, fn i -> render_inline(i))
  end

  pfn render_inline(inline : Inline) : IOList do
    match inline do
    Text(s)    -> IOList.from_string(Html.escape(s))
    Code(s)    -> IOList.from_string("<code>" ++ Html.escape(s) ++ "</code>")
    Emph(inlines) ->
      IOList.from_string("<em>")
      |> IOList.append(render_inlines(inlines))
      |> IOList.append(IOList.from_string("</em>"))
    Strong(inlines) ->
      IOList.from_string("<strong>")
      |> IOList.append(render_inlines(inlines))
      |> IOList.append(IOList.from_string("</strong>"))
    Link(url, title, inlines) ->
      IOList.from_string("<a href=\"" ++ Html.escape_attr(safe_url(url)) ++ "\"" ++ make_title_attr(title) ++ ">")
      |> IOList.append(render_inlines(inlines))
      |> IOList.append(IOList.from_string("</a>"))
    Image(url, alt, title) ->
      IOList.from_string("<img src=\"" ++ Html.escape_attr(safe_url(url)) ++ "\" alt=\"" ++ Html.escape_attr(alt) ++ "\"" ++ make_title_attr(title) ++ ">")
    HardBreak -> IOList.from_string("<br>")
    SoftBreak -> IOList.from_string(" ")
    end
  end

  pfn safe_url(url : String) : String do
    let lower = String.to_lowercase(url)
    if String.starts_with(lower, "javascript:") || String.starts_with(lower, "data:") do ""
    else url
    end
  end

  pfn make_title_attr(title : String) : String do
    if String.is_empty(title) do ""
    else " title=\"" ++ Html.escape_attr(title) ++ "\""
    end
  end

end
