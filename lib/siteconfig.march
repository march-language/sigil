-- Loads optional `sigil.toml` project config and merges it over the built-in
-- defaults.  Precedence (low -> high): defaults < sigil.toml < CLI flags.
-- This module only seeds the defaults from the config file; CLI flag overriding
-- happens afterwards in Ssg.parse_flags.
--
-- Schema (flat `[section]` tables, double-quoted string values):
--   [site]
--   title    = "My Site"
--   base_url = "https://example.com"
--   [build]
--   content_dir = "content"
--   output_dir  = "out"
--   static_dir  = "static"
--
-- Missing/unreadable file -> silently returns the unchanged defaults.
--
-- IMPLEMENTATION NOTE: this is a deliberately small line-based parser rather than
-- the stdlib `Toml` module.  Toml.parse produces a nested `TomlValue` whose
-- compiled (Perceus) manipulation is currently miscompiled — every shape we tried
-- failed natively: reading the value with `Toml.get_in` more than once aborts with
-- an RC underflow (each getter consumes the value), a single hand-walk that binds
-- `TTable(inner)`/`TStr(val)` comes back empty, and threading a multi-field
-- accumulator drops trailing fields.  A flat line scan that only threads Strings
-- and binds plain tuples (the same shape as Page.decode / FrontMatter.split, which
-- compile correctly) sidesteps all of those compiler bugs.
--
-- `scan`'s accumulator is bundled into a SINGLE record (`Acc`), not threaded as
-- separate String parameters: a self-recursive call whose argument list mixes a
-- freshly-computed value (e.g. `header_name(t)`, from `String.slice_bytes`) with
-- one or more OTHER arguments merely forwarded unchanged crashes the compiled
-- backend (bad-pointer read in `march_incrc`/`march_string_eq` — a double-free
-- from a TIR drop inserted after the tail call, freeing an argument the call
-- already consumed). Reproduces even with only 2 total scan params (one replaced,
-- one forwarded) and with the forwarded value being a record instead of a String,
-- so it isn't about String specifically or about argument count past some
-- threshold — it's specifically "replaced + forwarded together". Passing exactly
-- ONE argument that is always freshly reconstructed as a whole (copying forward
-- whichever fields don't change) sidesteps it.

mod SiteConfig do

  -- Default config file name, looked up relative to the current working dir.
  fn default_path() : String do "sigil.toml" end

  -- Scan accumulator: current [section] plus the five target Site fields,
  -- bundled into one value so the recursive `scan` call always passes exactly
  -- one freshly-reconstructed argument (see the module-level implementation note).
  type Acc = {
    section     : String,
    content_dir : String,
    output_dir  : String,
    static_dir  : String,
    title       : String,
    base_url    : String
  }

  -- Load `path` (e.g. "sigil.toml") and produce a Site seeded from it.
  -- A missing or unreadable file yields the unchanged defaults.
  fn load(path : String, def_content : String, def_output : String,
          def_static : String, def_title : String, def_base : String) : Result(Config.Site, String) do
    if File.exists(path) do
      match File.read(path) do
      Err(_) ->
        Ok({ content_dir: def_content, output_dir: def_output, static_dir: def_static,
             title: def_title, base_url: def_base })
      Ok(src) ->
        let lines = String.split(src, "\n")
        let acc = { section: "", content_dir: def_content, output_dir: def_output,
                    static_dir: def_static, title: def_title, base_url: def_base }
        Ok(scan(lines, acc))
      end
    else
      Ok({ content_dir: def_content, output_dir: def_output, static_dir: def_static,
           title: def_title, base_url: def_base })
    end
  end

  -- Scan the config line by line, tracking the current [section] and the five
  -- target fields in a single bundled accumulator (see the module-level note).
  pfn scan(lines : List(String), acc : Acc) : Config.Site do
    match lines do
    Nil ->
      { content_dir: acc.content_dir, output_dir: acc.output_dir, static_dir: acc.static_dir,
        title: acc.title, base_url: acc.base_url }
    Cons(line, rest) -> do
      let t = String.trim(line)
      if is_header(t) do
        scan(rest, { section: header_name(t), content_dir: acc.content_dir, output_dir: acc.output_dir,
                      static_dir: acc.static_dir, title: acc.title, base_url: acc.base_url })
      else
        match parse_kv(t) do
        None -> scan(rest, acc)
        Some(kv) ->
          match kv do
          (k, v) -> scan(rest, assign(acc, k, v))
          end
        end
      end
    end
    end
  end

  -- A "[section]" header line.
  pfn is_header(t : String) : Bool do
    String.starts_with(t, "[") && String.ends_with(t, "]")
  end

  -- Strip the surrounding brackets from a "[section]" header.
  pfn header_name(t : String) : String do
    String.slice_bytes(t, 1, String.byte_size(t) - 2)
  end

  -- Parse a `key = "value"` line into Some((key, unquoted_value)), or None for a
  -- blank line, a comment, or a line without `=`.
  pfn parse_kv(t : String) : Option((String, String)) do
    if String.is_empty(t) do None
    else if String.starts_with(t, "#") do None
    else
      match String.split_first(t, "=") do
      None -> None
      Some(pair) ->
        match pair do
        (k, v) -> Some((String.trim(k), unquote(String.trim(v))))
        end
      end
    end
    end
  end

  -- Strip a single pair of surrounding double quotes, if present.
  pfn unquote(s : String) : String do
    let n = String.byte_size(s)
    if n >= 2 && String.starts_with(s, "\"") && String.ends_with(s, "\"") do
      String.slice_bytes(s, 1, n - 2)
    else
      s
    end
  end

  -- Replace whichever field the "section"+"key" names (or leave the accumulator
  -- unchanged for an unrecognised pair).  Uses string-equality on the
  -- fully-qualified key — no tuple-pattern matching — which the native backend
  -- handles reliably.  Always reconstructs the WHOLE accumulator (see the
  -- module-level implementation note on why this can't split into a returned
  -- tuple threaded alongside `section`).
  pfn assign(acc : Acc, key : String, val : String) : Acc do
    let fq = acc.section ++ "." ++ key
    if fq == "build.content_dir" do
      { section: acc.section, content_dir: val, output_dir: acc.output_dir,
        static_dir: acc.static_dir, title: acc.title, base_url: acc.base_url }
    else if fq == "build.output_dir" do
      { section: acc.section, content_dir: acc.content_dir, output_dir: val,
        static_dir: acc.static_dir, title: acc.title, base_url: acc.base_url }
    else if fq == "build.static_dir" do
      { section: acc.section, content_dir: acc.content_dir, output_dir: acc.output_dir,
        static_dir: val, title: acc.title, base_url: acc.base_url }
    else if fq == "site.title" do
      { section: acc.section, content_dir: acc.content_dir, output_dir: acc.output_dir,
        static_dir: acc.static_dir, title: val, base_url: acc.base_url }
    else if fq == "site.base_url" do
      { section: acc.section, content_dir: acc.content_dir, output_dir: acc.output_dir,
        static_dir: acc.static_dir, title: acc.title, base_url: val }
    else acc
    end end end end end
  end

end
