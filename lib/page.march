mod Page do

  type Meta = {
    title       : String,
    raw_title   : Option(String),
    date        : String,
    layout      : String,
    tags        : List(String),
    draft       : Bool,
    nav_order   : Int,
    description : String,
    slug        : String
  }

  -- Derive the slug (filename without extension) from a source path.
  pfn slug_of(src_path : String) : String do
    let base = Path.basename(src_path)
    match String.last_index_of(base, ".") do
    None    -> base
    Some(i) ->
      if i == 0 do base
      else String.slice_bytes(base, 0, i)
      end
    end
  end

  -- Scan the lines of a YAML string for a specific key and return its value.
  -- Each line has the form "key: value" (simple YAML mapping).
  pfn get_field(lines : List(String), key : String) : Option(String) do
    match lines do
    Nil -> None
    Cons(line, rest) ->
      match String.split_first(line, ": ") do
      None ->
        get_field(rest, key)
      Some(pair) ->
        match pair do
        (k, v) ->
          if string_trim(k) == key do
            Some(string_trim(v))
          else
            get_field(rest, key)
          end
        end
      end
    end
  end

  -- Decode a YAML string into page metadata.
  -- Uses `src_path` to derive the default title (slug from filename).
  -- Missing fields get sensible defaults:
  --   title  -> slug
  --   date   -> ""
  --   layout -> "default"
  --   tags   -> Nil
  --   draft  -> false
  --
  -- Uses a simple line-by-line "key: value" parser to avoid the Yaml module.
  fn decode(src_path : String, yaml_str : String) : Meta do
    let default_title = slug_of(src_path)
    if yaml_str == "" do
      { title       = default_title,
        raw_title   = None,
        date        = "",
        layout      = "default",
        tags        = Nil,
        draft       = false,
        nav_order   = 0,
        description = "",
        slug        = "" }
    else
      let lines     = String.split(yaml_str, "\n")
      -- Extract each field independently to avoid RC underflow from tuple lists.
      let raw_title_opt = match get_field(lines, "title") do
                          Some(t) -> Some(t)
                          None    -> None
                          end
      let title     = match raw_title_opt do
                      Some(t) -> t
                      None    -> default_title
                      end
      let lines2 = String.split(yaml_str, "\n")
      let date   = match get_field(lines2, "date") do
                   Some(d) -> d
                   None    -> ""
                   end
      let lines3 = String.split(yaml_str, "\n")
      let layout = match get_field(lines3, "layout") do
                   Some(l) -> l
                   None    -> "default"
                   end
      let lines4 = String.split(yaml_str, "\n")
      let draft  = match get_field(lines4, "draft") do
                   Some("true")  -> true
                   Some("True")  -> true
                   Some("yes")   -> true
                   Some("Yes")   -> true
                   _             -> false
                   end
      let lines5 = String.split(yaml_str, "\n")
      let tags   = match get_field(lines5, "tags") do
                   Some(v) -> parse_flow_seq(v)
                   None    -> Nil
                   end
      let lines6 = String.split(yaml_str, "\n")
      let nav_order = match get_field(lines6, "nav_order") do
                      Some(v) -> parse_int_default(v, 0)
                      None    -> 0
                      end
      let lines7 = String.split(yaml_str, "\n")
      let description = match get_field(lines7, "description") do
                        Some(v) -> v
                        None    -> ""
                        end
      { title       = title,
        raw_title   = raw_title_opt,
        date        = date,
        layout      = layout,
        tags        = tags,
        draft       = draft,
        nav_order   = nav_order,
        description = description,
        slug        = "" }
    end
  end

  -- Parse an integer string, falling back to `dflt` on any non-numeric input.
  pfn parse_int_default(s : String, dflt : Int) : Int do
    match String.to_int(String.trim(s)) do
    Ok(n)  -> n
    Err(_) -> dflt
    end
  end

  -- Accessor for the draft field — avoids direct record field access across modules.
  fn meta_draft(m : Meta) : Bool do
    m.draft
  end

  -- Accessor for the title field — avoids direct record field access across modules.
  -- Returns the field directly (borrow-return); correct on the current compiler.
  fn meta_title(m : Meta) : String do
    m.title
  end

  -- Return a new Meta with the title field replaced.
  fn with_title(m : Meta, t : String) : Meta do
    { title       = t,
      raw_title   = m.raw_title,
      date        = m.date,
      layout      = m.layout,
      tags        = m.tags,
      draft       = m.draft,
      nav_order   = m.nav_order,
      description = m.description,
      slug        = m.slug }
  end

  -- Return a new Meta with the slug field replaced.  The slug is the page's
  -- output path relative to the content root (e.g. "docs/intro"); the build
  -- sets it at render time so layouts can mark the active nav entry.
  fn with_slug(m : Meta, s : String) : Meta do
    { title       = m.title,
      raw_title   = m.raw_title,
      date        = m.date,
      layout      = m.layout,
      tags        = m.tags,
      draft       = m.draft,
      nav_order   = m.nav_order,
      description = m.description,
      slug        = s }
  end

  -- Accessor for nav_order — drives sidebar ordering in custom layouts.
  fn meta_nav_order(m : Meta) : Int do
    m.nav_order
  end

  -- Accessor for the description field — used for the page <head> meta tag.
  fn meta_description(m : Meta) : String do
    m.description
  end

  -- Accessor for the slug field (set at render time; empty before that).
  fn meta_slug(m : Meta) : String do
    m.slug
  end

  -- Return the raw front-matter title if one was explicitly set, or None.
  -- None means no "title:" key was present in the YAML.
  fn raw_title(m : Meta) : Option(String) do
    m.raw_title
  end

  -- Return true if the page had an explicit "title:" key in its front-matter.
  fn has_title(m : Meta) : Bool do
    match m.raw_title do
    Some(_) -> true
    None    -> false
    end
  end

  -- Accessor for the layout field — avoids direct record field access across modules.
  fn meta_layout(m : Meta) : String do
    m.layout
  end

  -- Accessor for the date field — avoids direct record field access across modules.
  fn meta_date(m : Meta) : String do
    m.date
  end

  -- Accessor for the tags field — avoids direct record field access across modules.
  fn meta_tags(m : Meta) : List(String) do
    m.tags
  end

  -- Parse a YAML flow sequence like "[march, ssg]" into a List(String).
  -- Best-effort parser for simple unquoted string sequences.
  pfn parse_flow_seq(s : String) : List(String) do
    let trimmed = string_trim(s)
    let len     = String.byte_size(trimmed)
    if len >= 2 && String.starts_with(trimmed, "[") do
      -- Strip [ and ]
      let inner = String.slice_bytes(trimmed, 1, len - 2)
      let parts = String.split(inner, ",")
      List.filter_map(parts, fn p ->
        let t = string_trim(p)
        if t == "" do None
        else Some(t)
        end)
    else
      Nil
    end
  end

end
